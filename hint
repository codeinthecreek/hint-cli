#!/usr/bin/env bash
# hint - natural-language command lookup.
#
#   hint how do I create an ssh tunnel
#   hint history tunnel        past questions containing "tunnel"
#   hint search ssh            past answers containing "ssh"
#   hint remember [TOOL]         save the command that answered the last question
#   hint forget [TOOL]         mark a wrong command, so hint never shows it
#
# 1. An LLM (Ollama chat API) guesses 1-3 commands for the request.
# 2. hintdb find looks up the user's own history/notes rows for the request,
#    using the request's words and the guesses' tools, flags and words, and
#    prints them with the guesses as model suggestions.
# Nothing is executed.
#
# Env:
#   HINT_MODEL   Ollama model           (default qwen2.5-coder:3b)
#   OLLAMA_HOST  Ollama server URL      (default http://localhost:11434)
#   HINT_DEBUG   set to print the raw model guesses and find scores to stderr
# Requires: curl, jq, hintdb.
#
# Note: a script can't flush the calling shell's history. For commands from
# the current session to be indexed, the interactive shell needs
# `history -a` in PROMPT_COMMAND (or an equivalent hook).

set -o pipefail

usage() {
  cat >&2 <<'EOF'
usage: hint <what you want to do>
       hint history [OPTIONS] [WORD|N]
                                       past questions: the last 10, those
                                       with WORD, or the last N
       hint search [OPTIONS] WORD      past commands containing WORD
       hint history --show NUM         the full answer of past question NUM
       hint remember [TOOL]            save your last command (or your last
                                       TOOL command) as the answer to the
                                       last question, after you confirm it
       hint forget [TOOL]              mark the first command after the last
                                       question (or the first TOOL command)
                                       WRONG, so hint never shows it again
       hint -H, --history [OPTIONS] [WORD...]
                                       past questions containing all WORDs
       hint -S, --search [OPTIONS] WORD...
                                       past commands containing all WORDs
       hint -h, --help                 this help
OPTIONS, anywhere after history, search, -H or -S:
  -n, --last N     only the last N matching lines (default 10)
  -c, --count      print the number of matching lines instead
After history or -H only, and on its own (no WORD, -n or -c):
  -s, --show NUM   the full answer of entry NUM (the number that
                   history and search print), with each of your rows'
                   source files
  -d, --delete NUM[,NUM|NUM-NUM]...
                   delete entries from the log; the others keep their
                   numbers, and nothing is deleted if a NUM is not there
With a second WORD, the line is a question for the model instead:
  hint history without duplicates
An unknown option prints this help.
EOF
  exit 2
}

# past MODE FORM ARGS...   look up past lookups in the query log (hintdb log).
# MODE: history (match the question) or search (match the printed lines).
# FORM: "word" for `hint history WORD`, so a miss says how to ask instead.
past() {
  local mode=$1 form=$2 count= show= del= last= rc
  local opts=() words=()
  shift 2
  [ "$mode" = search ] && opts=(--printed)
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--last|--last=*)
        local n
        if [ "$1" = -n ] || [ "$1" = --last ]; then
          [ $# -ge 2 ] || usage
          n=$2; shift
        else
          n=${1#--last=}
        fi
        [[ $n =~ ^[1-9][0-9]*$ ]] || { echo "hint: --last needs a number of 1 or more" >&2; exit 2; }
        opts+=(--last "$n"); last=1 ;;
      -s|--show|--show=*)
        if [ "$1" = -s ] || [ "$1" = --show ]; then
          [ $# -ge 2 ] || usage
          show=$2; shift
        else
          show=${1#--show=}
        fi
        [[ $show =~ ^[1-9][0-9]*$ ]] || { echo "hint: --show needs an entry number" >&2; exit 2; } ;;
      -d|--delete|--delete=*)
        if [ "$1" = -d ] || [ "$1" = --delete ]; then
          [ $# -ge 2 ] || usage
          del=$2; shift
        else
          del=${1#--delete=}
        fi
        [[ $del =~ ^[1-9][0-9]*(-[1-9][0-9]*)?(,[1-9][0-9]*(-[1-9][0-9]*)?)*$ ]] || {
          echo "hint: --delete needs entry numbers: N, N,M or N-M" >&2; exit 2; } ;;
      -c|--count) opts+=(--count); count=1 ;;
      --) shift; words+=("$@"); break ;;
      -?*) usage ;;
      *) words+=("$1") ;;
    esac
    shift
  done
  command -v hintdb >/dev/null || { echo "hint: hintdb not found in PATH" >&2; exit 1; }
  # --show and --delete stand alone: no words, --last, --count or each other.
  if [ -n "$show$del" ]; then
    [ "$mode" = history ] && [ ${#words[@]} -eq 0 ] && [ -z "$count$last" ] \
      && [ -z "$show" -o -z "$del" ] || usage
    [ -n "$show" ] && exec hintdb log --show "$show"
    exec hintdb log --delete "$del"
  fi
  # `hint history 20`: a lone number is the last N, not a word.
  if [ "$form" = word ] && [ "$mode" = history ] && [ ${#words[@]} -eq 1 ] \
     && [[ ${words[0]} =~ ^[1-9][0-9]*$ ]]; then
    [ -z "$count" ] && opts+=(--last "${words[0]}")
    words=()
  fi
  [ "$mode" = search ] && [ ${#words[@]} -eq 0 ] && usage
  hintdb log "${opts[@]}" -- "${words[@]}"
  rc=$?
  if [ "$rc" -eq 1 ] && [ -z "$count" ]; then
    local what="questions"
    [ "$mode" = search ] && what="commands"
    if [ ${#words[@]} -eq 0 ]; then
      echo "hint: no past $what yet" >&2
    elif [ "$form" = word ]; then
      echo "hint: no past $what contain \"${words[*]}\"; to ask it as a question, add a word" >&2
    else
      echo "hint: no past $what contain \"${words[*]}\"" >&2
    fi
  fi
  exit "$rc"
}

# edit_line DEFAULT   show DEFAULT on an editable line (a plain read when
# stdin is not a terminal: tests, pipes) and set $line to what was entered.
# An empty line or Ctrl-C cancels: exit 1 / 130, with "nothing $done".
edit_line() {
  local done=$2
  trap 'echo >&2; echo "hint: cancelled, nothing $done" >&2; exit 130' INT
  if [ -t 0 ]; then
    IFS= read -r -e -i "$1" -p '> ' line || line=
  else
    printf '> %s\n' "$1" >&2
    IFS= read -r line || line=
  fi
  trap - INT
  if [ -z "${line//[[:space:]]/}" ]; then
    echo "hint: cancelled, nothing $done" >&2
    exit 1
  fi
}

# keys_help WHAT VERB NARGS   the line under the prompt's header: the keys,
# and how to reach another line (edit it; without a TOOL, name one).
keys_help() {
  local other="Not this line? Edit it"
  [ "$3" -eq 0 ] && other+=", or name its tool: hint $2 TOOL"
  printf '  %s, Ctrl-C cancels. %s.\n' "$1" "$other" >&2
}

# not_found_note   the last question is not in the history file, so the
# newest line is offered instead of one after the question.
not_found_note() {
  echo "  (your last question is not in your history file: this is your newest command)" >&2
}

# remember [TOOL]   save the last command (or the last TOOL command) in the
# history file as the answer to the last question, after the user confirms
# or edits it. hintdb picks both; nothing is saved without the prompt.
remember() {
  local cand n q where cmd line
  command -v hintdb >/dev/null || { echo "hint: hintdb not found in PATH" >&2; exit 1; }
  cand=$(hintdb remember -- "$@") || exit 1
  { IFS=$'\t' read -r n q where; IFS= read -r cmd; } <<<"$cand"
  printf 'remember as the answer to %s "%s":\n' "$n" "$q" >&2
  [ "$where" = after ] || not_found_note
  keys_help "Enter saves" remember $#
  edit_line "$cmd" saved
  hintdb remember --save -q "$q" -- "$line"
}

# forget [TOOL]   mark the first command after the last question (or the
# first TOOL command), as edited, WRONG in hint's own wrong file, with an
# optional reason. hint then never shows it. No source is changed. When
# nothing was run since the question, choose from the commands the last
# lookup printed instead, so a wrong suggestion can be marked unrun.
forget() {
  local cand n q where cmd line reason
  command -v hintdb >/dev/null || { echo "hint: hintdb not found in PATH" >&2; exit 1; }
  cand=$(hintdb forget -- "$@") || exit 1
  { IFS=$'\t' read -r n q where; IFS= read -r cmd; } <<<"$cand"
  if [ "$where" = list ]; then
    # Nothing run since the question: choose from what the lookup printed.
    local cmds i=0 num
    mapfile -t cmds < <(tail -n +2 <<<"$cand")
    printf 'which command? from "hint %s":\n' "$q" >&2
    for cmd in "${cmds[@]}"; do i=$((i + 1)); printf '  %d  %s\n' "$i" "$cmd" >&2; done
    trap 'echo >&2; echo "hint: cancelled, nothing saved" >&2; exit 130' INT
    if [ -t 0 ]; then
      IFS= read -r -e -p 'number (Ctrl-C cancels): ' num || num=
    else
      echo "number (Ctrl-C cancels):" >&2
      IFS= read -r num || num=
    fi
    trap - INT
    if ! [[ $num =~ ^[1-9][0-9]*$ ]] || [ "$num" -gt ${#cmds[@]} ]; then
      echo "hint: not a number from the list, nothing saved" >&2
      exit 1
    fi
    cmd=${cmds[num - 1]}
    echo "  Enter marks it WRONG, Ctrl-C cancels. Not this line? Edit it." >&2
  elif [ "$where" = after ]; then
    printf 'which command? the first after "hint %s":\n' "$q" >&2
  else
    echo "which command?" >&2
    [ -n "$q" ] && not_found_note
  fi
  [ "$where" = list ] || keys_help "Enter marks it WRONG" forget $#
  edit_line "$cmd" saved
  hintdb forget --marked -- "$line" && exit 0
  echo "reason (optional, Enter for none):" >&2
  trap 'echo >&2; echo "hint: cancelled, nothing saved" >&2; exit 130' INT
  if [ -t 0 ]; then
    IFS= read -r -e -p '> ' reason || reason=
  else
    IFS= read -r reason || reason=
  fi
  trap - INT
  hintdb forget --save --reason "$reason" -- "$line"
}

[ $# -gt 0 ] || usage
case "$1" in
  -h|--help) usage ;;
  -H|--history) shift; past history flag "$@" ;;
  -S|--search) shift; past search flag "$@" ;;
  # history alone: the last 10 lookups; search alone: usage (it needs a word).
  # At most one plain word plus options: a log lookup. Two or more plain
  # words: a question (falls through).
  history|search)
    [ $# -eq 1 ] && [ "$1" = search ] && usage
    plain=0 skip=
    for a in "${@:2}"; do
      if [ -n "$skip" ]; then skip=; continue; fi
      case "$a" in
        -n|--last|-s|--show|-d|--delete) skip=1 ;;
        -?*) ;;
        *) plain=$((plain + 1)) ;;
      esac
    done
    [ "$plain" -le 1 ] && past "$1" word "${@:2}" ;;
  # remember or forget alone or with one TOOL. Two or more words: a question
  # ("remember my ssh key passphrase", "forget a wifi network").
  remember|forget)
    if [ $# -le 2 ]; then
      case "${2:-}" in -?*) usage ;; esac
      op=$1; shift; "$op" "$@"; exit $?
    fi ;;
esac
# "help" alone is a command; "help me ..." is a question.
[ $# -eq 1 ] && [ "$1" = help ] && usage

for dep in curl jq hintdb; do
  command -v "$dep" >/dev/null || { echo "hint: $dep not found in PATH" >&2; exit 1; }
done

query="$*"
model="${HINT_MODEL:-qwen2.5-coder:3b}"
host="${OLLAMA_HOST:-http://localhost:11434}"
case "$host" in http://*|https://*) ;; *) host="http://$host" ;; esac

system="You suggest Linux shell commands. Reply with 1 to 3 commands that do what the user's request asks, best first, one per line. Each line is one complete command with example arguments. Output only the commands: no prose, no numbering, no markdown. If you are not sure which tool fits, use a different tool on each line."

# One worked example as a prior exchange, then the real request.
body=$(jq -n --arg model "$model" --arg system "$system" --arg query "$query" '{
  model: $model, stream: false,
  options: { temperature: 0, num_predict: 120 },
  messages: [
    { role: "system",    content: $system },
    { role: "user",      content: "show disk usage of a directory" },
    { role: "assistant", content: "du -sh /var/log\nncdu /var/log" },
    { role: "user",      content: $query }
  ]
}')

# A connection problem is a setup problem: say which, and stop.
resp=$(curl -s --fail-with-body --max-time 60 \
         -H 'Content-Type: application/json' \
         -d "$body" "$host/api/chat")
rc=$?
if [ $rc -ne 0 ]; then
  case $rc in
    6|7) echo "hint: cannot connect to Ollama at $host (is it running?)" >&2 ;;
    28)  echo "hint: Ollama at $host did not answer within 60 s (model $model)" >&2 ;;
    22)  err=$(jq -r '.error // empty' <<<"$resp" 2>/dev/null)
         echo "hint: Ollama at $host returned an error (model $model): ${err:-$resp}" >&2 ;;
    *)   echo "hint: no response from Ollama at $host (model $model; curl exit $rc)" >&2 ;;
  esac
  exit 1
fi

raw=$(jq -r '.message.content // empty' <<<"$resp")
[ -n "${HINT_DEBUG:-}" ] && printf 'hint: model guesses:\n%s\n' "$raw" >&2

# Clean model output: drop fences and blank lines, strip "$ " prompts,
# numbering and bullets.
mapfile -t lines < <(
  printf '%s\n' "$raw" |
  sed -E -e '/^[[:space:]]*```/d' \
         -e 's/^[[:space:]]*([0-9]+[.)]|[-*])[[:space:]]+//' \
         -e 's/^[[:space:]]*\$[[:space:]]+//' \
         -e 's/^[[:space:]]+|[[:space:]]+$//g' \
         -e '/^$/d'
)
# Drop prose ("I'm sorry, ...", "Alternatively, ..."), markdown bold and
# "#" comment lines: a line starting with "#" or "**", or whose first word
# starts with a capital letter and is not an installed command (VBoxManage
# is kept). Keep the first 3 lines left.
guesses=()
for line in "${lines[@]}"; do
  first=${line%%[[:space:]]*}
  case "$line" in
    '#'*|'**'*) prose=1 ;;
    [[:upper:]]*) command -v -- "$first" >/dev/null 2>&1 && prose= || prose=1 ;;
    *) prose= ;;
  esac
  if [ -n "$prose" ]; then
    [ -n "${HINT_DEBUG:-}" ] && printf 'hint: not a command, dropped: %s\n' "$line" >&2
    continue
  fi
  guesses+=("$line")
  [ ${#guesses[@]} -ge 3 ] && break
done

# No usable guesses: still look up the request's own words (a history
# comment may answer it).
if [ ${#guesses[@]} -eq 0 ] && [ -n "${HINT_DEBUG:-}" ]; then
  echo "hint: model returned no commands" >&2
fi

dbg=()
[ -n "${HINT_DEBUG:-}" ] && dbg=(--debug)
out=$(hintdb find "${dbg[@]}" --query="$query" -- "${guesses[@]}") || exit 1
if [ -z "$out" ]; then
  echo "Sorry, I didn't understand your question, can you rephrase it?" >&2
  exit 1
fi
printf '%s\n' "$out"
