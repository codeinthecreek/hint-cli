#!/usr/bin/env bash
# hint - natural-language command lookup.
#
#   hint how do I create an ssh tunnel
#
# 1. An LLM (Ollama chat API) guesses 1-3 commands for the request.
# 2. hintdb find looks up the user's own history/notes rows for the request,
#    using the request's words and the guesses' tools, flags and words, and
#    prints them with the guesses as model suggestions.
# Nothing is executed.
#
# Env:
#   HINT_MODEL   Ollama model           (default qwen2.5-coder:3b)
#   OLLAMA_HOST  Ollama server URL      (default http://localhost:11434)
#   HINT_DEBUG   set to print the raw model guesses and find scores to stderr
# Requires: curl, jq, hintdb.
#
# Note: a script can't flush the calling shell's history. For commands from
# the current session to be indexed, the interactive shell needs
# `history -a` in PROMPT_COMMAND (or an equivalent hook).

set -o pipefail

usage() { echo "usage: hint <what you want to do>" >&2; exit 2; }
[ $# -gt 0 ] || usage
case "$1" in -h|--help|help) usage ;; esac

for dep in curl jq hintdb; do
  command -v "$dep" >/dev/null || { echo "hint: $dep not found in PATH" >&2; exit 1; }
done

query="$*"
model="${HINT_MODEL:-qwen2.5-coder:3b}"
host="${OLLAMA_HOST:-http://localhost:11434}"
case "$host" in http://*|https://*) ;; *) host="http://$host" ;; esac

system="You suggest Linux shell commands. Reply with 1 to 3 commands that do what the user's request asks, best first, one per line. Each line is one complete command with example arguments. Output only the commands: no prose, no numbering, no markdown. If you are not sure which tool fits, use a different tool on each line."

# One worked example as a prior exchange, then the real request.
body=$(jq -n --arg model "$model" --arg system "$system" --arg query "$query" '{
  model: $model, stream: false,
  options: { temperature: 0, num_predict: 120 },
  messages: [
    { role: "system",    content: $system },
    { role: "user",      content: "show disk usage of a directory" },
    { role: "assistant", content: "du -sh /var/log\nncdu /var/log" },
    { role: "user",      content: $query }
  ]
}')

# A connection problem is a setup problem: say which, and stop.
resp=$(curl -s --fail-with-body --max-time 60 \
         -H 'Content-Type: application/json' \
         -d "$body" "$host/api/chat")
rc=$?
if [ $rc -ne 0 ]; then
  case $rc in
    6|7) echo "hint: cannot connect to Ollama at $host (is it running?)" >&2 ;;
    28)  echo "hint: Ollama at $host did not answer within 60 s (model $model)" >&2 ;;
    22)  err=$(jq -r '.error // empty' <<<"$resp" 2>/dev/null)
         echo "hint: Ollama at $host returned an error (model $model): ${err:-$resp}" >&2 ;;
    *)   echo "hint: no response from Ollama at $host (model $model; curl exit $rc)" >&2 ;;
  esac
  exit 1
fi

raw=$(jq -r '.message.content // empty' <<<"$resp")
[ -n "${HINT_DEBUG:-}" ] && printf 'hint: model guesses:\n%s\n' "$raw" >&2

# Clean model output: drop fences and blank lines, strip "$ " prompts,
# numbering and bullets.
mapfile -t lines < <(
  printf '%s\n' "$raw" |
  sed -E -e '/^[[:space:]]*```/d' \
         -e 's/^[[:space:]]*([0-9]+[.)]|[-*])[[:space:]]+//' \
         -e 's/^[[:space:]]*\$[[:space:]]+//' \
         -e 's/^[[:space:]]+|[[:space:]]+$//g' \
         -e '/^$/d'
)
# Drop prose ("I'm sorry, ...", "Alternatively, ..."), markdown bold and
# "#" comment lines: a line starting with "#" or "**", or whose first word
# starts with a capital letter and is not an installed command (VBoxManage
# is kept). Keep the first 3 lines left.
guesses=()
for line in "${lines[@]}"; do
  first=${line%%[[:space:]]*}
  case "$line" in
    '#'*|'**'*) prose=1 ;;
    [[:upper:]]*) command -v -- "$first" >/dev/null 2>&1 && prose= || prose=1 ;;
    *) prose= ;;
  esac
  if [ -n "$prose" ]; then
    [ -n "${HINT_DEBUG:-}" ] && printf 'hint: not a command, dropped: %s\n' "$line" >&2
    continue
  fi
  guesses+=("$line")
  [ ${#guesses[@]} -ge 3 ] && break
done

# No usable guesses: still look up the request's own words (a history
# comment may answer it).
if [ ${#guesses[@]} -eq 0 ] && [ -n "${HINT_DEBUG:-}" ]; then
  echo "hint: model returned no commands" >&2
fi

dbg=()
[ -n "${HINT_DEBUG:-}" ] && dbg=(--debug)
out=$(hintdb find "${dbg[@]}" --query="$query" -- "${guesses[@]}") || exit 1
if [ -z "$out" ]; then
  echo "Sorry, I didn't understand your question, can you rephrase it?" >&2
  exit 1
fi
printf '%s\n' "$out"
