# hint - natural-language command lookup backed by hintdb + a local LLM.
# Source from ~/.bashrc:   source ~/.local/share/hintdb/hint.bash
# Env: HINT_MODEL (default qwen2.5-coder:3b), HINT_N (context rows, default 15)

hint() {
  [ $# -gt 0 ] || { echo "usage: hint <what you want to do>" >&2; return 2; }
  local q="$*" ctx

  # Flush this shell's history so the index sees commands from this session.
  history -a

  ctx=$(hintdb query -n "${HINT_N:-15}" -- "$q") || return

  ollama run "${HINT_MODEL:-qwen2.5-coder:3b}" "You answer a Linux command lookup request with 1 to 3 complete command lines, best first, one per line. Output nothing else: no prose, no numbering, no markdown.

Rules:
- Each line must directly do what the request asks. Ignore context entries that only mention the same topic.
- A bare tool name is not an answer. Give the full command with arguments.
- Prefer the user's own form: the variant with the highest xN, with their usual flags.
- Keep placeholders like <HOST>, <PATH>, <FILE>, <N> for values the user must fill in, unless the request gives the value.
- If no context entry fits, answer from general knowledge.

Context format: command  # user's note  [xN = times used; also/e.g.: real variants]. A row tagged [man name(sec)] is a man page summary naming a tool; the rows right after it are the user's own uses of that tool.

Example:
Context:
du  # estimate file space usage  [man du(1)]
du -sh <PATH>  [x40; e.g.: du -sh /var/log | du -sh ~/work]
ncdu <PATH>  [x3]
df -h  [x12]
Request: disk usage of a directory
Answer:
du -sh <PATH>
ncdu <PATH>

Context:
${ctx:-(no matching entries)}
Request: $q
Answer:"
}
