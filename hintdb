# Placeholders for near-duplicate collapsing. Flags are deliberately untouched so
# `rm -rf <PATH>` and `rm -i <PATH>` stay different shapes.
# Last labels that mean "file name", not "host name", e.g. backup.tar.gz, app.conf.
FILE_EXT = {
    "txt", "md", "rst", "py", "sh", "bash", "pl", "rb", "js", "ts", "go", "rs", "c",
    "h", "cc", "cpp", "hpp", "java", "jar", "class", "json", "yaml", "yml", "toml",
    "ini", "cfg", "conf", "config", "xml", "html", "htm", "css", "csv", "tsv", "log",
    "gz", "tgz", "bz2", "xz", "zst", "zip", "tar", "7z", "rar", "deb", "rpm", "iso",
    "img", "qcow2", "vmdk", "raw", "pdf", "png", "jpg", "jpeg", "gif", "svg", "mp3",
    "mp4", "mkv", "service", "timer", "socket", "mount", "target", "pem", "crt",
    "key", "pub", "csr", "sql", "db", "sqlite", "bak", "old", "orig", "swp", "tmp",
    "lock", "env", "repo", "list", "so", "ko", "o", "a", "fa", "fasta", "fq",
    "fastq", "bam", "sam", "vcf", "bed", "gff", "gff3", "gtf", "ipynb", "tf",
    "tfvars", "j2", "tpl", "vim", "lua", "el", "patch", "diff", "desktop",
}
_LABELS = (r"(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\.)+"
           r"([A-Za-z][A-Za-z0-9-]*[A-Za-z0-9])(?![\w.-])")
HOSTNAME = re.compile(r"(?<![\w.<@/-])" + _LABELS)
HOSTNAME_AT = re.compile(r"(?<![\w.</-])" + _LABELS)   # also after user@
IPV4 = re.compile(r"\b\d{1,3}(\.\d{1,3}){3}(/\d+)?\b")
IPV6 = re.compile(r"(?<![\w:.])(?=[0-9a-fA-F:]*::)[0-9a-fA-F]{0,4}"
                  r"(?::[0-9a-fA-F]{0,4}){2,7}(?![\w:.])")


def _host(m):
    if m.group(1).lower() in FILE_EXT:
        return m.group(0)
    if m.string[max(0, m.start() - 3):m.start()] == "-m ":  # python -m http.server
        return m.group(0)
    return "<HOST>"


# Absolute, home, dot-relative and plain relative paths (anything containing '/').
PATH = re.compile(r"(?<![\w<./@-])(?:~|\.{1,2}|[\w.@%+-]+)?/[\w.@%+~/-]*")
# A bare file name with a known extension, e.g. backup.tar.gz, app.conf
BARE_FILE = re.compile(r"(?<![\w./<@-])[\w+-][\w.+-]*\.([A-Za-z0-9]+)(?![\w.-])")


def _file(m):
    return "<FILE>" if m.group(1).lower() in FILE_EXT else m.group(0)


def _path(m):
    # A trailing / changes meaning (rsync source, symlinked dirs): keep it.
    p = m.group(0)
    return "<PATH>/" if len(p) > 1 and p.endswith("/") else "<PATH>"


def host_template(cmd):
    """Replace only host names / IPs in a real command, keeping everything else."""
    return HOSTNAME_AT.sub(_host, IPV6.sub("<HOST>", IPV4.sub("<HOST>", cmd)))


SHAPE_SUBS = [
    # "x" / 'x' around a single token is just quoting style: drop the quotes
    # so `-R "1.2.3.4"` and `-R 1.2.3.4` get the same shape.
    (re.compile(r"(['\"])([^'\"\s]+)\1"), r"\2"),
    (re.compile(r"'[^']*'|\"[^\"]*\""), "<STR>"),
    (re.compile(r"\bhttps?://\S+"), "<URL>"),
    (re.compile(r"\b[\w.+-]+@[\w.-]+\b"), "<USER@HOST>"),
    (PATH, _path),
    (IPV4, "<HOST>"),
    (IPV6, "<HOST>"),
    (HOSTNAME, _host),
    (BARE_FILE, _file),
    (re.compile(r"\b[0-9a-f]{7,}\b"), "<HEX>"),
    (re.compile(r"(?<![\w-])\d+(\.\d+)*\b"), "<N>"),
]

STOP = {
    "a", "an", "the", "and", "or", "of", "to", "in", "on", "for", "from", "with",
    "by", "at", "is", "it", "its", "be", "do", "does", "how", "what", "which",
    "can", "i", "me", "my", "you", "your", "get", "show", "find", "list", "use",
    "using", "command", "commands", "way", "want", "need", "into", "that", "this",
    "all", "some", "any", "should", "would", "could", "there", "then",
}


def split_comment(line):
    """Split `cmd   # note` on the first unquoted '#' that starts a word."""
    sq = dq = esc = False
    prev = " "
    for i, ch in enumerate(line):
        if esc:
            esc = False
        elif ch == "\\" and not sq:
            esc = True
        elif ch == "'" and not dq:
            sq = not sq
        elif ch == '"' and not sq:
            dq = not dq
        elif ch == "#" and not sq and not dq and prev in " \t":
            return line[:i].strip(), line[i + 1:].strip()
        prev = ch
    return line.strip(), ""


def norm(cmd):
    return " ".join(cmd.split())


TRAILING_NUM = re.compile(r"(?<=[A-Za-z_])\d+\b")


def shape(cmd):
    s = norm(cmd)
    for pat, rep in SHAPE_SUBS:
        s = pat.sub(rep, s)
    # node1/node2, eth0, unit60 -> node<N> ... in arguments only, so the
    # command word itself (python3, md5sum) stays distinct.
    head, _, rest = s.partition(" ")
    return head + (" " + TRAILING_NUM.sub("<N>", rest) if rest else "")


TOKEN = re.compile(r"""(?:'[^']*'|"[^"]*"|\S)+""")


def unquote(t):
    return t[1:-1] if len(t) >= 2 and t[0] == t[-1] and t[0] in "'\"" else t


def token_shape(t):
    for pat, rep in SHAPE_SUBS:
        t = pat.sub(rep, t)
    return TRAILING_NUM.sub("<N>", t)


def template(variants):
    """Display form for a group: tokens identical in every variant are kept
    as written in variants[0]; tokens that vary become placeholders
    (user@<HOST>, /var/log/<PATH>, <FILE>, <N> ...)."""
    if len(variants) < 2:
        return variants[0]
    toks = [TOKEN.findall(v) for v in variants]
    if len({len(t) for t in toks}) != 1:
        return host_template(variants[0])
    out = []
    for col in zip(*toks):
        raw = [unquote(t) for t in col]
        if len(set(raw)) == 1:
            out.append(col[0])
            continue
        hosts = {host_template(t) for t in raw}
        if len(hosts) == 1:
            out.append(hosts.pop())
            continue
        if all(PATH.fullmatch(t) for t in raw):
            try:
                cp = os.path.commonpath(raw)
            except ValueError:
                cp = ""
            slash = "/" if all(len(t) > 1 and t.endswith("/") for t in raw) else ""
            out.append((cp.rstrip("/") + "/<PATH>" if cp not in ("", "/", ".", "~") else "<PATH>") + slash)
            continue
        # Shape the token as written: a quoted multi-word value must become
        # <STR>, not its unquoted words.
        out.append(token_shape(col[0]))
    return " ".join(out)


# Tools whose arguments are data (a search pattern, text to print), so a query
# word appearing in them says little about what the command does.
SEARCH_TOOLS = {"grep", "egrep", "fgrep", "zgrep", "rg", "ag", "ack", "find", "fd",
                "locate", "plocate", "sed", "awk", "echo", "printf"}
CMD_SEP = {"|", "||", "&&", ";", "|&"}
PREFIX = {"sudo", "doas", "env", "nohup", "exec", "time", "command", "nice",
          "ionice", "watch", "xargs", "builtin"}


def split_cmd(cmd):
    """Split a command into (prog, args, data) for weighted indexing:
    prog = command words (each pipeline stage), args = flags and plain words,
    data = paths, hosts, quoted strings, file names and search-tool arguments."""
    prog, args, data = [], [], []
    expect_cmd, tool = True, ""
    for t in TOKEN.findall(cmd):
        if t in CMD_SEP:
            expect_cmd = True
            continue
        if expect_cmd:
            if ASSIGN.match(t) or t in PREFIX or t.startswith("-"):
                args.append(t)
                continue
            prog.append(t)
            tool, expect_cmd = os.path.basename(t), False
            continue
        u = unquote(t)
        if tool in SEARCH_TOOLS or u != t or "/" in u or "<" in token_shape(u):
            data.append(t)
        else:
            args.append(t)
    return " ".join(prog), " ".join(args), " ".join(data)


def first_word(cmd):
    words = cmd.split()
    while words and (ASSIGN.match(words[0]) or words[0] in ("sudo", "doas", "env", "nohup", "exec", "time")):
        words.pop(0)
    return words[0] if words else ""


def is_trivial(cmd):
    words = cmd.split()
    return len(cmd) < 4 or (words[0] in TRIVIAL and len(words) <= 2)


def add_note(notes, note):
    """Add note to the list unless an existing note already contains it
    (ignoring case and whitespace); drop existing notes it contains."""
    note = " ".join(note.split())
    key = note.lower()
    if not key or any(key in n.lower() for n in notes):
        return
    notes[:] = [n for n in notes if n.lower() not in key] + [note]


def join_notes(*parts):
    out = []
    for p in parts:
        p = (p or "").strip()
        if p and p not in out:
            out.append(p)
    return "; ".join(out)

# ---------------------------------------------------------------- extractors
# Each yields (cmd, note).


def read_lines(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            yield line.rstrip("\n")


def extract_history(path):
    for line in read_lines(path):
        if re.fullmatch(r"#\d{9,11}", line):  # HISTTIMEFORMAT stamp lines
            continue
        cmd, note = split_comment(line)
        if cmd:
            yield cmd, note


FENCE = re.compile(r"^\s*(```+|~~~+)\s*([\w+-]*)")
SHELL_LANGS = {"", "bash", "sh", "shell", "zsh", "console", "shell-session",
               "sh-session", "terminal", "shellsession", "just"}
PROMPT_ONLY = {"console", "shell-session", "sh-session", "terminal", "shellsession"}


def extract_markdown(path):
    """Commands from shell fences and `$ ` lines; note = heading + last prose line
    + preceding `# comment` in the block + trailing comment."""
    heading = prose = cmt = pending = ""
    fence = None
    lang = ""
    for line in read_lines(path):
        s = line.strip()
        if fence:
            if s.startswith(fence):
                fence, cmt, pending = None, "", ""
                continue
            if lang not in SHELL_LANGS:
                continue
            if lang in PROMPT_ONLY:
                if not s.startswith("$ "):
                    continue
                s = s[2:]
            else:
                if s.startswith("$ "):
                    s = s[2:]
                if not s:
                    cmt = ""
                    continue
                if s.startswith("#") and not pending:
                    cmt = s.lstrip("#").strip()
                    continue
            if pending:
                s = pending + " " + s
                pending = ""
            if s.endswith("\\"):
                pending = s[:-1].strip()
                continue
            cmd, note = split_comment(s)
            if cmd:
                yield cmd, join_notes(heading, prose, cmt, note)
            continue
        m = FENCE.match(line)
        if m:
            fence, lang = m.group(1), m.group(2).lower()
            continue
        if s.startswith("#"):
            heading, prose = s.lstrip("#").strip(), ""
        elif s.startswith("$ "):
            cmd, note = split_comment(s[2:])
            if cmd:
                yield cmd, join_notes(heading, prose, note)
        elif s:
            prose = s[:200]


def extract_text(path):
    """Plain text: only `$ ` lines are commands; note = nearest non-command line."""
    ctx = ""
    for line in read_lines(path):
        s = line.strip()
        if s.startswith("$ "):
            cmd, note = split_comment(s[2:])
            if cmd:
                yield cmd, join_notes(ctx, note)
        elif s:
            ctx = s.lstrip("#").strip()[:200]


# Recipe files (justfiles, Makefiles). A recipe body line ending in `\`
# continues on the next line; the pieces are joined into one command, then
# the recipe prefixes (@ - +) are stripped once, from its start. Only single
# simple commands are kept: a joined line starting with a shell keyword or
# containing an unquoted ; && || (if-blocks, loops, chains) is dropped whole,
# and so is echo (progress messages, not commands to recall).
# The doc comment is the comment line directly above the recipe (a blank line
# in between ends it, so section dividers are not taken); in a Makefile a
# `## doc` on the target line comes first.

JUST_RECIPE = re.compile(r"^@?([A-Za-z_][\w-]*)(?:\s[^:]*)?:(?!=)")
# `name [name...]:` or `name::`, not `X := y`, `X ::= y`, `.PHONY:`, `%.o:`.
MAKE_TARGET = re.compile(r"^(?!\.)([\w/.-]+)(?:\s+[\w/.-]+)*\s*::?(?![=:])")
SHELL_KEYWORDS = {"if", "then", "else", "elif", "fi", "for", "while", "until",
                  "do", "done", "case", "esac", "select", "function", "[[", "!"}


def simple_command(cmd):
    """One command: not a shell keyword first, no unquoted ; && ||."""
    words = cmd.split()
    if not words or words[0] in SHELL_KEYWORDS or words[0][0] in "({":
        return False
    sq = dq = esc = False
    for i, ch in enumerate(cmd):
        if esc:
            esc = False
        elif ch == "\\" and not sq:
            esc = True
        elif ch == "'" and not dq:
            sq = not sq
        elif ch == '"' and not sq:
            dq = not dq
        elif not sq and not dq and (ch == ";" or cmd.startswith(("&&", "||"), i)):
            return False
    return True


def recipe_commands(body, make):
    """A recipe's body lines -> (cmd, trailing note) for its simple commands."""
    buf = ""
    for s in body:
        if not buf and s.startswith("#"):  # shebang or comment inside a recipe
            continue
        if s.endswith("\\") and not s.endswith("\\\\"):
            buf += s[:-1].strip() + " "
            continue
        line = (buf + s).strip()
        buf = ""
        line = line.lstrip("@-+" if make else "@-").strip()
        if make:
            line = line.replace("$$", "$")
        cmd, note = split_comment(line)
        if cmd and simple_command(cmd) and cmd.split()[0] != "echo":
            yield cmd, note


def extract_recipes(path, make):
    """Recipe body commands; note = `just|make <recipe>` + doc comment."""
    tool = "make" if make else "just"
    recipe = None
    body = []
    doc = comment = ""

    def flush():
        for cmd, note in recipe_commands(body, make):
            yield cmd, join_notes(f"{tool} {recipe}", doc, note)

    for line in read_lines(path):
        if not line.strip():
            comment = ""
            continue
        if recipe is not None and (line[:1] == "\t" or (not make and line[:1] == " ")):
            body.append(line.strip())
            continue
        s = line.strip()
        if s.startswith("#"):  # does not end a recipe; may be the next one's doc
            comment = s.lstrip("#").strip()
            continue
        if recipe is not None:
            yield from flush()
            recipe, body = None, []
        if s.startswith("["):  # just recipe attributes like [private]
            continue
        if make:
            head, tail = split_comment(s)
            m = MAKE_TARGET.match(head)
            if m:
                recipe, doc = m.group(1), tail.lstrip("#").strip() or comment
        else:
            m = JUST_RECIPE.match(line)
            if m:
                recipe, doc = m.group(1), comment
        comment = ""
    if recipe is not None:
        yield from flush()


def extract_just(path):
    return extract_recipes(path, make=False)


def extract_make(path):
    return extract_recipes(path, make=True)


# Git aliases ([alias] in a git config file). The row is what you type,
# `git <alias>`: a `!` alias is often a shell function, so its body is no
# command to recall. The note is the comment lines directly above the alias
# (a blank line ends them), the `#---` section heading it is under, then the
# body and the value's own trailing comment, so the alias is found by what
# it does.

GIT_SECTION = re.compile(r'^\s*\[\s*([\w.-]+)(?:\s+"[^"]*")?\s*\]')
GIT_KEY = re.compile(r"^\s*([A-Za-z][\w-]*)\s*=(.*)$")
GIT_ESC = {"n": "\n", "t": "\t", "b": "\b", '"': '"', "\\": "\\"}


def git_value(raw):
    """A git config value -> (value, trailing comment, continues). Quotes
    are removed, \\-escapes decoded; # or ; outside quotes starts a comment;
    a \\ at the end continues the value on the next line."""
    out, q, i = [], False, 0
    while i < len(raw):
        ch = raw[i]
        if ch == "\\":
            if i + 1 == len(raw):
                return "".join(out), "", True
            out.append(GIT_ESC.get(raw[i + 1], raw[i + 1]))
            i += 2
            continue
        if ch == '"':
            q = not q
        elif ch in "#;" and not q:
            return "".join(out).strip(), raw[i + 1:].strip(), False
        else:
            out.append(ch)
        i += 1
    return "".join(out).strip(), "", False


def extract_gitconfig(path):
    """`git <alias>` for each alias; note = comments above + body."""
    section = None
    doc = []
    pending = None  # [name, value so far, doc] while a value continues
    heading = ""
    for line in read_lines(path):
        if pending:
            val, cmt, more = git_value(line)
            pending[1] += val
            if more:
                continue
            name, body, d = pending
            pending = None
            yield f"git {name}", join_notes(d, " ".join(body.split()), cmt)
            continue
        s = line.strip()
        if not s:
            doc = []
            continue
        if s[0] in "#;":
            text = s.lstrip("#;").strip()
            if text.startswith("---"):  # section heading: context for the aliases under it
                heading, doc = text.strip(" -=#"), []
            else:
                doc.append(text.strip(" -=#"))
            continue
        m = GIT_SECTION.match(s)
        if m:
            section, doc, heading = m.group(1).lower(), [], ""
            continue
        m = GIT_KEY.match(s)
        if section != "alias" or not m:
            doc = []
            continue
        val, cmt, more = git_value(m.group(2).strip())
        d = join_notes(" ".join(x for x in doc if x), heading)
        doc = []
        if more:
            pending = [m.group(1), val, d]
            continue
        yield f"git {m.group(1)}", join_notes(d, " ".join(val.split()), cmt)


# Bash aliases (`alias name='body'` lines, also inside if-blocks or after
# `[ -x ... ] &&`). As for git aliases the row is what you type, the alias
# name. The note is the comment lines above the block of aliases it is in
# (a blank line ends a block: "# safety aliases" covers rm, mv and cp), then
# the body and the line's trailing comment. Commented-out code (`#alias x=`,
# `#if ...`: no space after the #) is not a comment. An alias that only adds
# options to the command of the same name (ls='ls --color=auto') is skipped:
# there is nothing to recall.

ALIAS_LINE = re.compile(r"^\s*(?:.*&&\s*)?alias\s+(.*)$")


def extract_bash_aliases(path):
    """The alias name for each alias; note = block comment + body."""
    doc, block = [], False
    for line in read_lines(path):
        s = line.strip()
        if not s:
            doc, block = [], False
            continue
        if s.startswith("#"):
            if s.startswith("# ") or s == "#":
                if block:  # a comment after aliases starts a new block
                    doc, block = [], False
                doc.append(s.lstrip("#").strip())
            continue
        m = ALIAS_LINE.match(s)
        if not m:
            continue
        rest, cmt = split_comment(m.group(1))
        try:
            words = shlex.split(rest)
        except ValueError:
            continue
        block = True
        for w in words:
            name, eq, body = w.partition("=")
            if not eq or not body.strip():
                continue
            body = " ".join(body.split())
            if body.split()[0] == name:
                continue
            yield name, join_notes(" ".join(x for x in doc if x), body, cmt)


EXTRACT = {"history": extract_history, "md": extract_markdown,
           "text": extract_text, "just": extract_just,
           "make": extract_make, "git": extract_gitconfig,
           "alias": extract_bash_aliases}

# ---------------------------------------------------------------- sources


def detect_kind(path):
    base = os.path.basename(path)
    if base.lower() in JUST_NAMES:
        return "just"
    if base.lower() in MAKE_NAMES:
        return "make"
    if base.lower() in GIT_NAMES or path.endswith(os.sep + os.path.join("git", "config")):
        return "git"
    if base.lower() in ALIAS_NAMES:
        return "alias"
    ext = os.path.splitext(base)[1].lower()
    if ext in NOTE_EXT:
        return NOTE_EXT[ext]
    if "history" in base.lower():
        return "history"
    return None


def load_sources():
    if not os.path.exists(SOURCES):
        hist = os.environ.get("HISTFILE") or os.path.expanduser("~/.bash_history")
        save_sources([("history", hist)])
    out = []
    for line in read_lines(SOURCES):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        kind, _, path = line.partition("\t")
        out.append((kind, path))
    return out


def save_sources(srcs):
    os.makedirs(os.path.dirname(SOURCES), exist_ok=True)
    with open(SOURCES, "w") as f:
        f.write("# kind<TAB>path   kind: history|md|text|just|make|git|alias|auto (auto = detect per file)\n")
        for kind, path in srcs:
            f.write(f"{kind}\t{path}\n")


def expand(srcs):
    """Registered sources -> concrete (kind, file) list. Directories are walked,
    skipping hidden dirs; files with no detectable kind are ignored there."""
    files = []
    for kind, path in srcs:
        if os.path.isdir(path):
            for root, dirs, names in os.walk(path):
                dirs[:] = sorted(d for d in dirs if not d.startswith("."))
                for n in sorted(names):
                    p = os.path.join(root, n)
                    k = detect_kind(p) if kind == "auto" else kind
                    if k:
                        files.append((k, p))
        elif os.path.isfile(path):
            k = detect_kind(path) if kind == "auto" else kind
            files.append((k or "text", path))
        else:
            print(f"hintdb: source missing, skipped: {path}", file=sys.stderr)
    return files


# Bump when the index layout or cleaning rules change, so existing DBs rebuild.
SCHEMA_VERSION = "17"


def fingerprint(files):
    h = hashlib.sha1(f"schema {SCHEMA_VERSION}\nignore {sorted(IGNORE_CMDS)}\n".encode())
    for kind, p in files:
        try:
            st = os.stat(p)
        except OSError:
            continue
        h.update(f"{kind}\0{p}\0{st.st_mtime_ns}\0{st.st_size}\n".encode())
    return h.hexdigest()

# ---------------------------------------------------------------- build


# A history line whose trailing comment starts with WRONG as a whole word
# (capitals; then the end, punctuation or a space) marks its command as
# wrong in itself: `history -n 10  # WRONG!`, `# WRONG: -n takes no count`.
WRONG_MARK = re.compile(r"WRONG(?![A-Za-z0-9_])")


def is_wrong_mark(note):
    return bool(WRONG_MARK.match(note.strip()))


def wrong_marks(files):
    """{command: [(file, line number, comment)]} for the marked lines of the
    history-kind files (runs of spaces in the command as one)."""
    marks = {}
    for kind, path in files:
        if kind != "history":
            continue
        try:
            for i, line in enumerate(read_lines(path), 1):
                cmd, note = split_comment(line)
                if cmd and is_wrong_mark(note):
                    marks.setdefault(norm(cmd), []).append((path, i, note.strip()))
        except OSError:
            continue
    return marks


def build(files):
    marks = wrong_marks(files)   # commands never indexed, from any source
    groups = {}   # shape -> group dict
    exact = {}    # normalized cmd -> [count, last_seen, kind]
    aliases = set()   # bash alias names: count as installed, like commands on PATH
    for kind, path in files:
        try:
            rows = list(EXTRACT[kind](path))
        except OSError as e:
            print(f"hintdb: cannot read {path}: {e}", file=sys.stderr)
            continue
        total = max(len(rows), 1)
        for i, (cmd, note) in enumerate(rows):
            cmd = norm(cmd)
            if not cmd or SECRET.search(cmd):
                continue
            if os.path.basename(first_word(cmd)) in IGNORE_CMDS:
                continue
            if cmd in marks:
                continue
            if is_trivial(cmd) and not note:
                continue
            if kind == "alias":
                aliases.add(cmd)
            recency = (i + 1) / total if kind == "history" else 0.0
            e = exact.setdefault(cmd, [0, 0.0, kind])
            e[0] += 1
            e[1] = max(e[1], recency)
            if kind != "history":
                e[2] = kind
            g = groups.setdefault(shape(cmd), {"variants": {}, "hnotes": [], "nnotes": [],
                                               "vnotes": {},
                                               "kinds": set(), "sources": set()})
            g["variants"][cmd] = e
            g["kinds"].add(kind)
            g["sources"].add(path)   # for "found in <source>"
            if note:
                # searched: history comments and notes-file text apart, so
                # find can weigh history comments more
                add_note(g["hnotes" if kind == "history" else "nnotes"], note)
                add_note(g["vnotes"].setdefault(cmd, []), note)   # shown per variant

    which_cache = {}

    def known(word):
        if word not in which_cache:
            which_cache[word] = ("/" in word or word in BUILTINS or word in aliases
                                 or shutil.which(word) is not None)
        return which_cache[word]

    rows = []
    for shp, g in groups.items():
        variants = g["variants"]
        count = sum(v[0] for v in variants.values())
        # One-off history-only lines whose command is not on PATH are probably
        # typos. Repeated ones survive (aliases, functions).
        if g["kinds"] == {"history"} and count == 1 and not g["hnotes"]:
            if not known(first_word(next(iter(variants)))):
                continue
        ranked = sorted(variants.items(), key=lambda kv: (kv[1][1], kv[1][0]), reverse=True)
        best = ranked[0][0]
        by_count = [c for c, _ in sorted(ranked[1:], key=lambda kv: kv[1][0], reverse=True)]
        display = template([best] + by_count)
        # Templated rows show real examples (most recent first); plain rows
        # show up to 2 other variants.
        examples = [best] + by_count[:1] if display != best else by_count[:2]
        # The status label's kind: history first, then a recipe file or
        # aliases, then notes.
        kind = next((k for k in ("history", "make", "just", "git", "alias") if k in g["kinds"]),
                    "note")
        prog, args, data = split_cmd(best)
        cmdword = os.path.basename(prog.split()[0]) if prog else ""
        vnotes = g["vnotes"]
        # A note describes the whole row only if variants carrying it account
        # for at least half the uses; otherwise it stays with its own variant.
        weight = {}
        for c, ns in vnotes.items():
            for nt in ns:
                weight[nt] = weight.get(nt, 0) + variants[c][0]
        majority = [nt for nt, w in weight.items() if w * 2 >= count]
        dnote = "; ".join(majority)
        shown = [[c, "; ".join(n for n in vnotes.get(c, []) if n not in majority)]
                 for c in examples]
        rows.append((prog, args, data, " | ".join(examples),
                     "; ".join(g["hnotes"])[:500], "; ".join(g["nnotes"])[:500],
                     display, dnote[:300], json.dumps(shown), cmdword, shp, count,
                     max(v[1] for v in variants.values()), kind,
                     json.dumps(sorted(g["sources"]))))

    write_db(DB, ENTRIES_SCHEMA, ENTRIES_INSERT, rows, fingerprint(files),
             {"aliases": json.dumps(sorted(aliases)),
              "wrong": json.dumps(sorted([c, p, n, note] for c, ms in marks.items()
                                         for p, n, note in ms))})
    return len(rows)


# Searched columns: prog, args, data (values), variants, hnote (history
# comments), nnote (text from notes files). The rest are for display only, so
# placeholder words like "host" never match.
ENTRIES_SCHEMA = """
    CREATE VIRTUAL TABLE entries USING fts5(
      prog, args, data, variants, hnote, nnote,
      display UNINDEXED, dnote UNINDEXED, examples UNINDEXED,
      cmdword UNINDEXED, shape UNINDEXED,
      count UNINDEXED, recency UNINDEXED, kind UNINDEXED, sources UNINDEXED,
      tokenize = 'porter unicode61');
    """
ENTRIES_INSERT = "INSERT INTO entries VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)"


def write_db(path, schema, insert, rows, fp, meta=None):
    """Build a DB in a temp file next to `path`, then atomically replace it."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), suffix=".tmp")
    os.close(fd)
    try:
        con = sqlite3.connect(tmp)
        con.executescript(schema + "CREATE TABLE meta(key TEXT PRIMARY KEY, value TEXT);")
        con.executemany(insert, rows)
        con.execute("INSERT INTO meta VALUES ('fingerprint', ?)", (fp,))
        con.executemany("INSERT INTO meta VALUES (?, ?)", (meta or {}).items())
        con.commit()
        con.close()
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def stored_fingerprint(path):
    if not os.path.exists(path):
        return None
    try:
        con = sqlite3.connect(path)
        row = con.execute("SELECT value FROM meta WHERE key='fingerprint'").fetchone()
        con.close()
        return row[0] if row else None
    except sqlite3.Error:
        return None

# ---------------------------------------------------------------- man pages
# NAME lines of all installed section 1/8 pages, from `apropos .` (man-db's
# index), in a separate DB that is rebuilt only when man-db's index changes.

MANDB = os.environ.get("HINTDB_MANDB", os.path.join(os.path.dirname(DB), "man.db"))
APROPOS_CMD = os.environ.get("HINTDB_APROPOS", "apropos .")   # override for testing
APROPOS_LINE = re.compile(r"^(.+?)\s+\(([^)]+)\)\s+-\s+(.*)$")


def man_enabled():
    return os.environ.get("HINTDB_NO_MAN") is None and (
        "HINTDB_APROPOS" in os.environ or shutil.which("apropos") is not None)


def man_fingerprint():
    """man-db rewrites its index.* files when mandb runs (pacman hook / daily
    timer). Without them, fall back to rebuilding once a day."""
    files = sorted(glob.glob("/var/cache/man/**/index.*", recursive=True))
    if not files:
        return f"schema {SCHEMA_VERSION} day-" + time.strftime("%Y%m%d")
    h = hashlib.sha1(f"schema {SCHEMA_VERSION}\n{APROPOS_CMD}".encode())
    for p in files:
        try:
            st = os.stat(p)
        except OSError:
            continue
        h.update(f"{p}\0{st.st_mtime_ns}\0{st.st_size}\n".encode())
    return h.hexdigest()


def build_man():
    try:
        out = subprocess.run(shlex.split(APROPOS_CMD), capture_output=True, text=True,
                             timeout=120).stdout
    except (OSError, subprocess.SubprocessError) as e:
        print(f"hintdb: man index skipped: {e}", file=sys.stderr)
        return 0
    pages = {}
    for line in out.splitlines():
        m = APROPOS_LINE.match(line.strip())
        if not m:
            continue
        names, sec, desc = m.groups()
        # Commands only: sections 1 and 8 (incl. 1ssl etc.), not POSIX 1p copies.
        if sec[:1] not in "18" or sec.endswith("p"):
            continue
        for name in names.split(","):
            name = name.strip()
            if name and name not in pages:
                pages[name] = (name, desc.strip(), sec)
    write_db(MANDB, """
        CREATE VIRTUAL TABLE pages USING fts5(
          name, desc, section UNINDEXED, tokenize = 'porter unicode61');
        """, "INSERT INTO pages VALUES (?,?,?)", list(pages.values()), man_fingerprint())
    return len(pages)


def all_files(srcs):
    """The registered sources' files plus the built-in answers and wrong
    files, when they exist (read as history)."""
    files = expand(srcs)
    for builtin in (ANSWERS, WRONG):
        if os.path.isfile(builtin) and not any(p == builtin for _, p in files):
            files.append(("history", builtin))
    return files


def update(force=False):
    """Rebuild whichever index is stale. Returns (entries, pages); None = unchanged."""
    files = all_files(load_sources())
    n = m = None
    if force or stored_fingerprint(DB) != fingerprint(files):
        n = build(files)
    if man_enabled() and (force or stored_fingerprint(MANDB) != man_fingerprint()):
        m = build_man()
    return n, m

# ---------------------------------------------------------------- query


def query_terms(text):
    terms = []
    for t in re.findall(r"[\w./-]+", text.lower()):
        t = t.strip("./-")
        if len(t) >= 2 and t not in STOP:
            terms.append(t)
    return list(dict.fromkeys(terms))


def coverage(terms, text):
    """Fraction of query terms present in text (crude stemming by prefix)."""
    toks = set(re.findall(r"[a-z0-9]+", text.lower()))
    hit = 0
    for t in terms:
        parts = re.findall(r"[a-z0-9]+", t)
        if parts and all(any(k.startswith(p[:max(3, len(p) - 2)]) for k in toks) for p in parts):
            hit += 1
    return hit / len(terms)


MAN_HITS = 5        # man pages per query
MAN_MIN_COVERAGE = 0.5   # a man hit must match at least half the query terms


def query(text, n):
    """Keyword search, for debugging: the user's rows ranked by find's score
    for the question alone (bm25 of its words, use count as tie-breaker; no
    model guesses, so no tool, flag or guess-word parts), each with its score;
    then man NAME lines that match at least half the question's words."""
    terms = query_terms(text)
    if not terms:
        return []
    con = open_db()
    try:
        r = score_rows(con, text, [], lambda msg: None)
        out = ["%5.2f  %s" % (x[0], fmt((x[7], x[8], x[9], x[5]))) for x in r["scored"][:n]]
        if os.path.exists(MANDB):
            q = " OR ".join('"%s"' % p for t in terms for p in fts_words(t))
            con.execute("ATTACH DATABASE ? AS man", (MANDB,))
            for name, desc, sec in con.execute(
                    "SELECT name, desc, section FROM man.pages WHERE pages MATCH ? "
                    "ORDER BY bm25(pages, 2.0, 1.0) LIMIT ?", (q, MAN_HITS)):
                if coverage(terms, name + " " + desc) >= MAN_MIN_COVERAGE:
                    out.append(f"man    {name}({sec}): {desc}")
    finally:
        con.close()
    return out


def fmt_example(ex):
    cmd, note = ex
    return cmd + (f"  # {note}" if note else "")


def fmt(entry):
    display, examples, dnote, count = entry[:4]
    line = display + (f"  # {dnote}" if dnote else "")
    extra = []
    if count > 1:
        extra.append(f"x{count}")
    examples = json.loads(examples) if examples else []
    if examples:
        extra.append(("e.g.: " if "<" in display else "also: ")
                     + " | ".join(fmt_example(e) for e in examples))
    return line + (f"  [{'; '.join(extra)}]" if extra else "")

# ---------------------------------------------------------------- find
# The user's rows for a question: found by the question's words (bm25) and
# the model's guesses (tool, flags, words). See DESIGN.md, "Find".


def jaccard(sa, sb):
    if not sa and not sb:
        return 1.0
    return len(sa & sb) / len(sa | sb)


_BUNDLES = None


def single_flags():
    """tool -> the single-letter flags the user typed alone with it (`grep -r`,
    `grep -i`), from the index. A multi-letter single-dash token of that tool
    is a bundle of short flags only if all its letters are among them, so
    `grep -ri` counts as `-r -i` while `find -name` stays whole (no
    `find -n -a -m -e`)."""
    global _BUNDLES
    if _BUNDLES is None:
        _BUNDLES = {}
        if os.path.exists(DB):
            try:
                for shp, cw in sqlite3.connect(DB).execute("SELECT shape, cmdword FROM entries"):
                    for t in shp.split()[1:]:
                        if re.fullmatch(r"-[A-Za-z]", t):
                            _BUNDLES.setdefault(cw, set()).add(t[1])
            except sqlite3.Error:
                pass
    return _BUNDLES


def flag_set(tokens, tool=None):
    """-x, --long (value after '=' dropped) and dig-style +opt tokens (a letter
    after the +: `+short`, not `find -mtime +30`). With the row's tool, a
    bundle of short flags counts as its letters (see single_flags())."""
    out = set()
    for t in tokens:
        if len(t) < 2 or t[0] not in "-+" or (t[0] == "+" and not t[1].isalpha()):
            continue
        if (tool and re.fullmatch(r"-[A-Za-z]{2,}", t)
                and set(t[1:]) <= single_flags().get(tool, set())):
            out |= {"-" + c for c in t[1:]}
        else:
            out.add(t.split("=", 1)[0])
    return out


def overlap(guess_shape, row_shape, tool=None):
    """(primary, all): primary is the overlap of option flags, ignoring values;
    when the guess has no flags, of its plain words (`compose down`, `get
    pods`), not placeholders, so `ssh user@host` gives no credit to every
    `ssh <USER@HOST>` row; 0 when it has neither. all is the overlap of all
    argument tokens (tool word excluded), a tie-breaker. Shapes are compared,
    so values are already placeholders."""
    ga, ra = guess_shape.split()[1:], row_shape.split()[1:]
    all_ = jaccard(set(ga), set(ra))
    gf = flag_set(ga, tool)
    if gf:
        primary = jaccard(gf, flag_set(ra, tool))
    else:
        gl = literal_words(guess_shape)
        primary = jaccard(gl, literal_words(row_shape)) if gl else 0.0
    return primary, all_


def man_page(con, tool):
    """(section, NAME description) of the tool's man page, or None."""
    if not os.path.exists(MANDB):
        return None
    try:
        con.execute("ATTACH DATABASE ? AS man", (MANDB,))
    except sqlite3.OperationalError:
        pass  # already attached
    return con.execute("SELECT section, desc FROM man.pages WHERE name = ?",
                       (tool,)).fetchone()


MAX_ROWS = 5
# Score weights (DESIGN.md: chosen on the eval set, so fitted to it).
W_TOOL, W_FLAGS, W_GUESS_WORDS, W_COUNT = 0.3, 0.3, 0.3, 0.02
# bm25 column weights: prog, args, data, variants, hnote, nnote. A history
# comment is the user's own words about the command, so it weighs more.
FIND_BM25 = "bm25(entries, 1.0, 1.0, 1.0, 1.0, 1.5, 1.0)"
# Values and variants are searched only when the question mentions a path.
CMD_COLS = "{prog args hnote nnote}"
PATH_WORDS = {"dir", "dirs", "directory", "directories", "folder", "folders",
              "path", "paths"}
# Words in model guesses that are filler, not what the guess is about.
GENERIC = {"path", "to", "user", "username", "file", "example", "com", "server",
           "remote", "directory", "dir", "localhost", "your", "my", "name", "host"}


def literal_words(shp):
    """Plain words of a shape after the tool: not flags, placeholders or
    separators (`list` in `docker exec -it ollama ollama list`)."""
    toks = shp.split()
    while toks and (toks[0] in PREFIX or ASSIGN.match(toks[0])):
        toks = toks[1:]
    return {t for t in toks[1:] if t[0] not in "-+" and "<" not in t and t not in CMD_SEP}


def show_key(cmdword, shp):
    """Rows with the same key differ only in values and are shown once: same
    tool, flags and literal words, and the same paths with a trailing / (it
    changes meaning: rsync source, symlinked directories)."""
    toks = shp.split()[1:]
    return (cmdword, frozenset(flag_set(toks, cmdword)), frozenset(literal_words(shp)),
            tuple(t.endswith("/") for t in toks if "<" in t or "/" in t))


ALIASES = set()   # bash alias names from the alias sources, loaded by find


def installed(tool):
    """Installed here: on PATH, a shell builtin or one of your bash aliases
    (or an explicit path)."""
    return tool in BUILTINS or tool in ALIASES or shutil.which(tool) is not None


def tool_of(cmd):
    prog = split_cmd(norm(cmd))[0]
    return os.path.basename(prog.split()[0]) if prog else ""


def guess_words(guess):
    """Literal words of a guess outside flags: tool, subcommands, path parts."""
    out = []
    for t in TOKEN.findall(guess):
        if t.startswith("-") or t in CMD_SEP:
            continue
        for w in re.findall(r"[a-z][a-z0-9]{2,}", t.lower()):
            if w not in GENERIC and w not in STOP and w not in out:
                out.append(w)
    return out


def path_mentioned(text):
    return ("/" in text or "~" in text
            or bool(PATH_WORDS & set(re.findall(r"[a-z]+", text.lower()))))


def fts_words(term):
    return re.findall(r"[a-z0-9]+", term.lower())


def rows_with(con, term, cols=None):
    """Row ids containing every word of term (by porter stem), in cols."""
    parts = fts_words(term)
    if not parts:
        return set()
    m = " AND ".join('"%s"' % p for p in parts)
    if cols:
        m = f"{cols} : ({m})"
    return {r for (r,) in con.execute("SELECT rowid FROM entries WHERE entries MATCH ?", (m,))}


def score_rows(con, text, guesses, dbg):
    """Score the user's rows for the question `text` and the model's guesses
    (already normalised): bm25 of the question's words plus the guesses'
    tools, flags and words. Returns the candidates, best first, and what was
    used to score them. Shared by `find` and `query` (with no guesses)."""
    terms = query_terms(text)
    paths = path_mentioned(text)
    cols = None if paths else CMD_COLS
    tools = list(dict.fromkeys(t for t in (tool_of(g) for g in guesses) if t))
    gwords = []
    for g in guesses:
        gwords += [w for w in guess_words(g) if w not in gwords]
    gshapes = [(tool_of(g), shape(g)) for g in guesses]

    # Tool credit: 1.0 for the first guess's tool, 0.7 for later ones.
    tool_w = {t: (1.0 if i == 0 else 0.7) for i, t in enumerate(tools)}
    # A guessed tool `a-b` is also read as `a b` when the user's rows use
    # that form (docker-compose -> docker compose). Decided by the user's
    # rows, not a list of tools; it changes scoring only, not what is printed.
    for g in guesses:
        t = tool_of(g)
        if "-" not in t:
            continue
        a, b = t.split("-", 1)
        if not con.execute("SELECT 1 FROM entries WHERE cmdword = ? AND "
                           "(args = ? OR args LIKE ?) LIMIT 1", (a, b, b + " %")).fetchone():
            continue
        tool_w.setdefault(a, tool_w[t])
        gshapes.append((a, shape(norm(g).replace(t, a + " " + b, 1))))
        if b not in gwords and b not in GENERIC and b not in STOP and len(b) > 2:
            gwords.append(b)
        dbg(f"guessed tool {t} also read as '{a} {b}' (the user's form)")
    nrows = con.execute("SELECT COUNT(*) FROM entries").fetchone()[0]
    idf, found = {}, {}
    for t in terms + gwords:
        if t not in idf:
            idf[t] = math.log(1 + nrows / (1 + len(rows_with(con, t))))
            found[t] = rows_with(con, t, cols)

    # bm25 over any word of the question, scaled so the best row is 1.
    bm = {}
    parts = list(dict.fromkeys(p for t in terms for p in fts_words(t)))
    if parts:
        m = " OR ".join('"%s"' % p for p in parts)
        if cols:
            m = f"{cols} : ({m})"
        bm = {rid: -s for rid, s in con.execute(
            f"SELECT rowid, {FIND_BM25} FROM entries WHERE entries MATCH ?", (m,))}
        best = max(bm.values(), default=0) or 1
        bm = {rid: s / best for rid, s in bm.items()}

    # Candidates: a question word OR a guessed tool.
    cand = set().union(*(found[t] for t in terms)) if terms else set()
    for t in tool_w:
        cand |= {r for (r,) in con.execute(
            "SELECT rowid FROM entries WHERE cmdword = ?", (t,))}
    gtot = sum(idf[w] for w in gwords) or 1
    scored = []
    for rid in cand:
        display, examples, dnote, shp, count, kind, sources, cmdword = con.execute(
            "SELECT display, examples, dnote, shape, count, kind, sources, cmdword "
            "FROM entries WHERE rowid = ?", (rid,)).fetchone()
        tb = tool_w.get(cmdword, 0.0)
        ov = [overlap(gs, shp, cmdword) for t, gs in gshapes if t == cmdword]
        fl = max([o[0] for o in ov] or [0.0])
        alltok = max([o[1] for o in ov] or [0.0])   # tie-breaker (trailing / etc.)
        gw = sum(idf[w] for w in gwords if rid in found[w]) / gtot
        q = bm.get(rid, 0.0)
        s = q + W_TOOL * tb + W_FLAGS * fl + W_GUESS_WORDS * gw + W_COUNT * math.log(count)
        scored.append((s, q, tb, fl, gw, count, rid, display, examples, dnote, shp,
                       kind, sources, cmdword, alltok))
    # Equal scores: the row closest to a guess in all its tokens first.
    scored.sort(key=lambda x: (-round(x[0], 9), -x[14], -x[5], x[7]))
    return dict(terms=terms, paths=paths, tools=tools, gwords=gwords, idf=idf,
                found=found, scored=scored)


def open_db():
    if not os.path.exists(DB):
        con = sqlite3.connect(":memory:")
        con.executescript(ENTRIES_SCHEMA)
        return con
    return sqlite3.connect(DB)


def wrong_of(con):
    """{command: the comment of its first WRONG mark} from the index's meta."""
    try:
        row = con.execute("SELECT value FROM meta WHERE key='wrong'").fetchone()
    except sqlite3.Error:
        return {}
    out = {}
    for c, _, _, note in json.loads(row[0]) if row else []:
        out.setdefault(c, note)
    return out


def find(text, guesses, debug=False, rows=None):
    """The user's rows for the question `text`, scored by bm25 of its words
    plus the guesses' tools, flags and words; then the model's guesses. Two
    lines per result: command, status. Returns [] when nothing was found.
    When `rows` is a list, each printed row of the user's is appended to it as
    {"line": ..., "sources": [...]}, for the query log."""
    def dbg(msg):
        if debug:
            print("hintdb: " + msg, file=sys.stderr)

    guesses = list(dict.fromkeys(g for g in (norm(x) for x in guesses) if g))
    con = open_db()
    marked = wrong_of(con)   # commands the user marked WRONG: {command: comment}
    try:
        row = con.execute("SELECT value FROM meta WHERE key='aliases'").fetchone()
        ALIASES.update(json.loads(row[0]) if row else [])
    except sqlite3.OperationalError:   # no index yet
        pass
    try:
        r = score_rows(con, text, guesses, dbg)
        terms, paths, tools, gwords = r["terms"], r["paths"], r["tools"], r["gwords"]
        idf, found, scored = r["idf"], r["found"], r["scored"]

        dbg(f"words: {terms}" + ("  (path mentioned: values searched too)" if paths else ""))
        dbg(f"guessed tools: {tools}  guess words: {gwords}")
        dbg(f"{len(scored)} candidate rows" + (", top:" if scored else ""))
        if scored:
            dbg("   score   bm25 tool flags gwords  uses   command")
        for x in scored[:12]:
            dbg("  %6.3f  %5.2f  %3.1f  %4.2f  %5.2f  x%-5d  %s%s" % (
                x[:6] + (x[7], ("  # " + x[9][:50]) if x[9] else "")))

        # The user's rows: up to MAX_ROWS installed ones; rows with the same
        # tool, flags and literal words differ only in values and show once.
        # Uninstalled rows ranked above the last printed row become comments.
        # A tool-only row (no question word but its own tool name, no flag
        # shared with a guess) is shown at most once per tool, and its place is
        # not refilled: when the evidence runs out the list gets shorter.
        mine, shapes, keys, missing = [], set(), set(), {}
        tool_only, skipped, miss = set(), 0, []
        for x in scored:
            if len(mine) + skipped >= MAX_ROWS:
                break
            shp, cmdword = x[10], x[13]
            key = show_key(cmdword, shp)
            if key in keys:
                continue
            keys.add(key)
            if cmdword and not installed(cmdword):
                m = missing.setdefault(cmdword, {"rows": [], "sources": set()})
                if len(m["rows"]) < MAX_ROWS:
                    m["rows"].append(x[7])
                    m["sources"].update(json.loads(x[12] or "[]"))
                    miss.append({"line": x[7], "sources": json.loads(x[12] or "[]")})
                continue
            if x[3] == 0 and not any(x[6] in found[t] for t in terms if t != cmdword):
                if cmdword in tool_only:
                    skipped += 1
                    continue
                tool_only.add(cmdword)
            mine.append(x)
            shapes.add(shp)
        if rows is not None:   # in printed order: the user's rows, then uninstalled ones
            rows.extend({"line": x[7], "sources": json.loads(x[12] or "[]")} for x in mine)
            rows.extend(miss)

        theirs = [g for g in guesses if installed(tool_of(g)) and shape(g) not in shapes]
        # A guess the user marked WRONG: never first or second, printed after
        # the other guesses with the mark (its tool and words still guide the
        # search above).
        wrong = [g for g in theirs if norm(g) in marked]
        theirs = [g for g in theirs if norm(g) not in marked]
        if wrong:
            dbg("marked WRONG by the user, printed last: " + "; ".join(wrong))
        # Who leads: the user's best row, when it holds more than half the
        # question's words (by rarity); otherwise the model's first guess.
        half = 0.0
        if mine:
            tot = sum(idf[t] for t in terms) or 1
            half = sum(idf[t] for t in terms if mine[0][6] in found[t]) / tot
        lead = bool(theirs) and not (mine and half > 0.5)
        if mine:
            dbg(f"best row holds {half:.2f} of the question's words -> "
                + ("model's guess leads" if lead else "user's row leads"))

        def row_lines(x):
            display, examples, note, count, kind = x[7], x[8], x[9], x[5], x[11]
            status = (f"your history x{count}" if kind == "history"
                      else SOURCE_LABEL.get(kind, "your notes"))
            status += f": {note}" if note else ""
            ex = json.loads(examples) if examples else []
            if "<" in display and ex:
                status += "; e.g. " + fmt_example(ex[0])
            return [display, "  # " + status]

        out = []
        if lead:
            out += [theirs[0], "  # most likely (model suggestion)"]
            for x in mine:
                out += row_lines(x)
            rest = theirs[1:]
        else:
            for i, x in enumerate(mine):
                out += row_lines(x)
                if i == 0 and theirs:   # the model's guess second
                    out += [theirs[0], "  # model suggestion"]
            rest = theirs[1:]
        label = "model suggestion" if mine else "alternative (model suggestion)"
        for g in rest:
            out += [g, "  # " + label]
        for g in wrong:
            out += [g, f"  # {marked[norm(g)]} (model suggestion, marked by you)"]
        seen = set()
        for g in theirs + wrong:
            t = tool_of(g)
            page = man_page(con, t) if t not in seen else None
            seen.add(t)
            if page:
                out.append(f"# see man {t}({page[0]}): {page[1]}")
    finally:
        con.close()
    for tool, m in missing.items():
        src = ", ".join(sorted({os.path.basename(p) for p in m["sources"]})) or "your sources"
        out.append(f"# found in {src}, but {tool} is not installed here:")
        out.extend("#   " + d for d in m["rows"])
    if not out and guesses:
        out.append("# no installed command found; the model suggested the following:")
        out.extend("#   " + g + (f"   ({marked[norm(g)]}, marked by you)" if norm(g) in marked else "")
                   for g in guesses)
    return out

def source_counts(con):
    """[(source file, (entries, entries from no other source))], most first.
    A command found in two sources is one entry listing both, so it counts
    for each; "only from this source" is what removing the source drops."""
    per = {}
    for (srcs,) in con.execute("SELECT sources FROM entries"):
        srcs = json.loads(srcs or "[]")
        for p in srcs:
            r = per.setdefault(p, [0, 0])
            r[0] += 1
            if len(srcs) == 1:
                r[1] += 1
    return sorted(((p, tuple(r)) for p, r in per.items()), key=lambda x: (-x[1][0], x[0]))


def source_entries(con, path):
    """One line per entry from the source file PATH (or any file under the
    directory PATH), most uses first: `display  [xN]  # note`, plus the other
    sources for an entry that is not only from this one."""
    path = os.path.abspath(os.path.expanduser(path))
    mine = lambda p: p == path or p.startswith(path.rstrip("/") + "/")
    rows = []
    for display, dnote, count, srcs in con.execute(
            "SELECT display, dnote, count, sources FROM entries"):
        srcs = json.loads(srcs or "[]")
        if not any(mine(os.path.abspath(p)) for p in srcs):
            continue
        other = [tilde(p) for p in srcs if not mine(os.path.abspath(p))]
        note = "; ".join(x for x in (dnote, other and "also in " + ", ".join(other)) if x)
        rows.append((-count, display, f"{display}  [x{count}]" + (f"  # {note}" if note else "")))
    return [r[2] for r in sorted(rows)]

# ---------------------------------------------------------------- query log


def log_lookup(query, guesses, printed, rows):
    """Append one JSON line per lookup to LOG. A single O_APPEND write under
    an exclusive flock, so lookups from several terminals do not interleave
    and none is lost during a --delete. Failing to log only warns: the
    answer has already been printed."""
    rec = {"time": time.strftime("%Y-%m-%dT%H:%M:%S"), "query": query,
           "guesses": guesses, "printed": printed, "rows": rows}
    data = (json.dumps(rec, ensure_ascii=True) + "\n").encode()
    try:
        d = os.path.dirname(LOG)
        if d:
            os.makedirs(d, exist_ok=True)
        fd = os.open(LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            os.write(fd, data)
        finally:
            os.close(fd)   # closing releases the lock
    except OSError as e:
        print(f"hintdb: cannot write query log {LOG}: {e}", file=sys.stderr)

def read_log():
    """Entries of the query log, oldest first, each with its line number in
    the file as "n" (stable: the log is only appended to). Unreadable lines
    are skipped but keep their numbers."""
    out = []
    try:
        with open(LOG, encoding="utf-8", errors="replace") as f:
            for n, line in enumerate(f, 1):
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if isinstance(rec, dict) and isinstance(rec.get("query"), str):
                    rec["n"] = n
                    out.append(rec)
    except FileNotFoundError:
        pass
    return out


def has_words(text, words):
    text = text.lower()
    return all(w.lower() in text for w in words)


def printed_of(rec):
    return [x for x in rec.get("printed") or [] if isinstance(x, str)]


def log_time(rec):
    return str(rec.get("time", "")).replace("T", " ")[:16]


def log_history(words):
    """The lookups whose question or printed commands contain every word
    (case-insensitive substrings), oldest first, each as a list of lines:
    number, time, question; then, indented, each printed command that
    matched (its text or its status comment; labels such as "your history
    x3" do not match). Without words, every lookup, one line each."""
    out = []
    for r in read_log():
        cmds = matched_commands(r, words) if words else []
        if not cmds and not has_words(r["query"], words):
            continue
        out.append(["%5d  %s  %s" % (r["n"], log_time(r), r["query"])]
                   + [" " * 9 + c for c in cmds])
    return out


SOURCE_LABEL = {"make": "your Makefile", "just": "your justfile", "git": "your git aliases",
                "alias": "your aliases"}
STATUS_LABEL = re.compile(r"^\s*#\s*(?:your history x\d+|your (?:notes|Makefile|justfile|git aliases|aliases))(?:[:;]\s*|$)|^\s*#.*model suggestion\)?$")


def status_note(line):
    """The note of a printed status line, without its label ("your history
    x3: ", "your notes: ", "your Makefile: ", "model suggestion"), so labels
    do not match."""
    if not line.startswith("  #"):
        return ""
    return STATUS_LABEL.sub("", line, count=1)


def matched_commands(rec, words):
    """The command lines a lookup printed whose text or status comment
    contains every word, in printed order, once each."""
    lines, out = printed_of(rec), []
    for i, cmd in enumerate(lines):
        if cmd[:1] in ("#", " ", "") or cmd in out:
            continue
        note = status_note(lines[i + 1]) if i + 1 < len(lines) else ""
        if has_words(cmd + "\n" + note, words):
            out.append(cmd)
    return out


def parse_numbers(spec):
    """"41", "41,42", "41-45" or a mix -> (single numbers, ranges)."""
    singles, ranges = [], []
    for part in spec.split(","):
        m = re.fullmatch(r"([1-9]\d*)(?:-([1-9]\d*))?", part.strip())
        if not m:
            return None
        a = int(m.group(1))
        if m.group(2):
            b = int(m.group(2))
            if b < a:
                return None
            ranges.append((a, b))
        else:
            singles.append(a)
    return singles, ranges


def log_delete(spec):
    """Blank the log lines of the given entries. Lines are blanked, not
    removed, so other entries keep their numbers. Every single number must
    be an entry, or nothing is deleted; a range deletes the entries in it.
    The file is rewritten in place under the same flock the appends take.
    Returns (deleted entries, error message or None)."""
    nums = parse_numbers(spec)
    if nums is None:
        return [], f"not an entry number, list or range: {spec}"
    singles, ranges = nums
    try:
        f = open(LOG, "r+", encoding="utf-8", errors="replace")
    except FileNotFoundError:
        return [], "the query log is empty"
    with f:
        fcntl.flock(f, fcntl.LOCK_EX)
        lines = f.readlines()
        entries = {}
        for n, line in enumerate(lines, 1):
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if isinstance(rec, dict) and isinstance(rec.get("query"), str):
                rec["n"] = n
                entries[n] = rec
        missing = [n for n in singles if n not in entries]
        if missing:
            return [], "no entry %s in the query log; nothing deleted" % ", ".join(map(str, missing))
        todo = set(singles) | {n for a, b in ranges for n in entries if a <= n <= b}
        if not todo:
            return [], f"no entries in {spec}; nothing deleted"
        for n in todo:
            lines[n - 1] = "\n"
        f.seek(0)
        f.write("".join(lines))
        f.truncate()
    return [entries[n] for n in sorted(todo)], None


def tilde(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path == home or path.startswith(home + "/") else path


def log_show(n):
    """The full entry with line number n: header, then the printed lines,
    each of the user's rows followed by `# from <source files>` (from the
    log's rows), so the line can be found and fixed in its source."""
    for r in read_log():
        if r["n"] != n:
            continue
        src = {}
        for row in r.get("rows") or []:
            if isinstance(row, dict) and isinstance(row.get("line"), str):
                src.setdefault(row["line"], [str(p) for p in row.get("sources") or []])
        printed = printed_of(r)
        out = ["%5d  %s  %s" % (n, log_time(r), r["query"])]
        for i, x in enumerate(printed):
            out.append("  " + x)
            if x.startswith("#   "):          # a "not installed" row
                cmd, indent = x[4:], "#     "
            elif x[:1] not in ("#", " ", ""):  # a command line
                cmd, indent = x, "  # "
                if i + 1 < len(printed) and printed[i + 1].startswith("  #"):
                    continue                   # added after its status line
            elif x.startswith("  #") and i > 0 and printed[i - 1][:1] not in ("#", " ", ""):
                cmd, indent = printed[i - 1], "  # "
            else:
                continue
            if src.get(cmd):
                out.append("  " + indent + "from " + ", ".join(tilde(p) for p in src[cmd]))
        return out if printed else out + ["  (nothing found)"]
    return None

# ---------------------------------------------------------------- answers

HOUSEKEEPING = {"history", "fc"}


def live_history():
    """The history file bash is writing now: $HISTFILE if exported, else
    ~/.bash_history. Never chosen from the sources (other histories there
    are for reference)."""
    return os.environ.get("HISTFILE") or os.path.expanduser("~/.bash_history")


def spaced_ops(cmd):
    """Spaces around unquoted runs of `;`, `|` and `&`, so `history -a;hint`
    splits into its commands (the index's tokens keep `-a;` whole)."""
    out, sq, dq, esc, i = [], False, False, False, 0
    while i < len(cmd):
        ch = cmd[i]
        if esc:
            esc = False
        elif ch == "\\" and not sq:
            esc = True
        elif ch == "'" and not dq:
            sq = not sq
        elif ch == '"' and not sq:
            dq = not dq
        elif ch in ";|&" and not sq and not dq:
            j = i
            while j < len(cmd) and cmd[j] in ";|&":
                j += 1
            out.append(f" {cmd[i:j]} ")
            i = j
            continue
        out.append(ch)
        i += 1
    return "".join(out)


def line_tools(cmd):
    """The command words of a line, each pipeline or list stage's (sudo,
    env and the like skipped, paths dropped): `sudo /usr/sbin/ss -l | grep x`
    -> ["ss", "grep"]."""
    return [os.path.basename(w) for w in split_cmd(norm(spaced_ops(cmd)))[0].split()]


def question_line(lines, query):
    """Index of the last history line that asked QUERY (`hint WORDS` whose
    words, split as the shell does, join to the logged question), or None."""
    want = norm(query)
    for i in range(len(lines) - 1, -1, -1):
        cmd = split_comment(lines[i])[0]
        if not cmd.startswith("hint"):
            continue
        try:
            words = shlex.split(cmd)
        except ValueError:      # unbalanced quotes
            continue
        if words and words[0] == "hint" and norm(" ".join(words[1:])) == want:
            return i
    return None


def pick_line(tool="", verb="remember", why=None):
    """((last lookup or None, command, anchored), None) or (None, error).
    When the last question is found in the live history, only the lines after
    it count, and the pick is the first of them for forget (the suggestion
    tried right after asking) and the last for remember (the one that finally
    worked): with TOOL the first/last line where any command is TOOL,
    without it the first/last line that is not trivial. Lines that run hint
    are always skipped. When the question is not in the file (asked in
    another terminal, quotes shlex cannot split), the newest line, skipping
    also history housekeeping, as before (anchored False). When there is a
    last lookup, the history file must have been written since.
    When `why` is a list, the reason for these two failures is appended to
    it: "stale" (not written since the question) or "nothing" (no command,
    or only trivial ones, after the question)."""
    why = why if why is not None else []
    recs = read_log()
    rec = recs[-1] if recs else None
    hist = live_history()
    try:
        mtime = os.stat(hist).st_mtime
        lines = list(read_lines(hist))
    except OSError:
        return None, (f"cannot read your history file {tilde(hist)}; "
                      "if it is elsewhere, export HISTFILE in ~/.bashrc")
    try:
        asked = time.mktime(time.strptime(str(rec.get("time")), "%Y-%m-%dT%H:%M:%S"))
    except (AttributeError, ValueError):
        asked = None
    if asked is not None and mtime < asked:
        why.append("stale")
        again = f"hint {verb}" + (f" {tool}" if tool else "")
        return None, (f"your history file has not been written since you asked\n"
                      f"  \"{rec['query']}\"; run:  history -a; {again}")
    start = question_line(lines, rec["query"]) if rec else None
    anchored = start is not None
    if anchored:
        span = lines[start + 1:]
        if verb == "remember":
            span = span[::-1]
    else:
        span = lines[::-1]
    skipped = []   # trivial lines after the question, in span order
    for line in span:
        if re.fullmatch(r"#\d{9,11}", line):   # HISTTIMEFORMAT stamp lines
            continue
        cmd = split_comment(line)[0]
        if not cmd:
            continue
        tools = line_tools(cmd)
        if "hint" in tools:
            continue
        if tool:
            if tool in tools:
                return (rec, cmd, anchored), None
        elif (tools and not is_trivial(norm(cmd))
              and (anchored or not set(tools) <= HOUSEKEEPING)):
            return (rec, cmd, anchored), None
        elif anchored and tools:
            skipped.append(cmd)
    if anchored:
        why.append("nothing")
    if anchored and not tool and skipped:
        # Say what was skipped and how to take each: name its tool. Per
        # tool, the line `hint VERB TOOL` takes (skipped is in pick order:
        # newest first for remember, oldest first for forget); listed in the
        # file's order.
        picks = {}
        for c in skipped:
            picks.setdefault(line_tools(c)[0], c)
        rows = sorted(picks.items(), key=lambda kv: skipped.index(kv[1]),
                      reverse=(verb == "remember"))[-5:]
        width = max(len(c) for _, c in rows)
        return None, (f"only trivial commands since you asked \"{rec['query']}\";\n"
                      "to take one, name its tool:\n"
                      + "\n".join(f"  {c.ljust(width)}   hint {verb} {t}" for t, c in rows))
    what = f"no {tool} command" if tool else "no command"
    if anchored:
        return None, f"{what} since you asked \"{rec['query']}\""
    return None, f"{what} found in {tilde(hist)}"


PLACEHOLDER = re.compile(r"<[A-Z][A-Z@]*>")


def printed_commands(rec):
    """The exact commands a lookup printed, in order, once each: the user's
    rows and the model's guesses, also the "not installed" ones; not the
    status lines, and not rows shown as templates (`user@<HOST>`): a mark
    needs one exact command."""
    out = []
    for x in printed_of(rec):
        if x.startswith("#   "):        # a "not installed" row or guess
            x = x[4:].split("   (")[0]
        elif x[:1] in ("#", " ", ""):
            continue
        x = norm(x)
        if x and not PLACEHOLDER.search(x) and x not in out:
            out.append(x)
    return out


def forget_pick(tool):
    """For `hintdb forget`: the line to offer, as print_pick prints it, or
    the last lookup's commands to choose from (`NUM<TAB>QUESTION<TAB>list`,
    then one command per line) when nothing was run after the question, or
    the history file was not written since it. Already marked commands are
    left out. Returns (lines, error)."""
    why = []
    res, err = pick_line(tool, "forget", why)
    if res:
        return pick_lines(res), None
    recs = read_log()
    if tool or not recs or not why:
        return None, err
    rec = recs[-1]
    marks = wrong_marks(all_files(load_sources()))
    cmds = [c for c in printed_commands(rec) if c not in marks]
    if not cmds:
        return None, (f"nothing to mark: \"{rec['query']}\" printed no exact "
                      "command that is not marked already")
    return [f"{rec['n']}\t{rec['query']}\tlist"] + cmds, None


def pick_lines(res):
    """`NUM<TAB>QUESTION<TAB>after|newest`, then the command. NUM and
    QUESTION are empty when there is no lookup yet."""
    rec, cmd, anchored = res
    n, q = (rec["n"], rec["query"]) if rec else ("", "")
    return [f"{n}\t{q}\t{'after' if anchored else 'newest'}", cmd]


def print_pick(res):
    """For hint: `NUM<TAB>QUESTION<TAB>after|newest`, then the command.
    NUM and QUESTION are empty when there is no lookup yet."""
    rec, cmd, anchored = res
    n, q = (rec["n"], rec["query"]) if rec else ("", "")
    print(f"{n}\t{q}\t{'after' if anchored else 'newest'}")
    print(cmd)


def remember_candidate(tool=""):
    """((last lookup, command), None) or (None, error message): the last
    question and the line that answers it (see pick_line)."""
    if ANSWERS == os.devnull:
        return None, "answers are off (HINTDB_ANSWERS=/dev/null)"
    if not read_log():
        return None, "no question to answer yet: ask one with hint first"
    return pick_line(tool, "remember")


def forget_where(cmd):
    """Where the exact command is, in the live history (first, registered or
    not) and every file the index is built from. Returns (found, marked,
    has_live): found = [(file, kind, [line numbers])] of the lines without
    a WRONG mark, marked = [(file, line number)] of the lines with one.
    History-kind files match the line's command (comment dropped, spaces as
    one); other files a line containing it."""
    want = norm(cmd)
    live = os.path.realpath(live_history())
    # The live history first: the bash steps printed below are about it.
    files = [("history", live_history())] + all_files(load_sources())
    found, marked, seen, has_live = [], [], set(), False
    for kind, path in files:
        real = os.path.realpath(path)
        if real in seen:
            continue
        seen.add(real)
        try:
            lines = list(read_lines(path))
        except OSError:
            continue
        nums = []
        for i, line in enumerate(lines, 1):
            if kind == "history":
                c, note = split_comment(line)
                if norm(c) != want:
                    continue
                if is_wrong_mark(note):
                    marked.append((path, i))
                    continue
            elif want not in norm(line):
                continue
            nums.append(i)
        if nums:
            found.append((path, kind, nums))
            has_live = has_live or real == live
    return found, marked, has_live


def forget_report(cmd):
    """The lines printed by `hintdb forget --where`, or None if not found."""
    found, marked, _ = forget_where(cmd)
    if not found and not marked:
        return None
    out = []
    if marked:
        out.append(marked_line(cmd, marked))
    if found:
        names = [tilde(p) for p, _, _ in found]
        width = max(len(n) for n in names)
        out.append(f"{norm(cmd)} is in:" if not marked else "Unmarked copies:")
        for name, (_, _, nums) in zip(names, found):
            word = "line" if len(nums) == 1 else "lines"
            out.append(f"  {name.ljust(width)}  {word} {', '.join(map(str, nums))}")
    return out


def marked_line(cmd, marked):
    where = "; ".join(f"{tilde(p)} line {n}" for p, n in marked)
    return f"{norm(cmd)} is already marked WRONG: {where}"


def forget_save(cmd, reason):
    """Append `COMMAND  # WRONG!` (or `# WRONG: REASON`) to the wrong file.
    Returns (lines to print, error). Nothing is saved when the command is
    already marked anywhere."""
    cmd = split_comment(cmd.strip())[0]
    reason = " ".join(reason.split())
    if WRONG == os.devnull:
        return None, "marks are off (HINTDB_WRONG=/dev/null)"
    if not cmd or "\n" in cmd:
        return None, "nothing to save: the command must be one line"
    found, marked, has_live = forget_where(cmd)
    if marked:
        return None, marked_line(cmd, marked)
    line = f"{cmd}  # WRONG: {reason}" if reason else f"{cmd}  # WRONG!"
    try:
        d = os.path.dirname(WRONG)
        if d:
            os.makedirs(d, exist_ok=True)
        fd = os.open(WRONG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            os.write(fd, (line + "\n").encode())
        finally:
            os.close(fd)
    except OSError as e:
        return None, f"cannot write {WRONG}: {e}"
    out = [f"saved: {line}"]
    if not found:
        return out + ["hint now hides it."], None
    # One file per line, like --where: a long path cannot break the text.
    names = [tilde(p) for p, _, _ in found]
    width = max(len(n) for n in names)
    out.append("hint now hides it. It is still in" + (" your history (up-arrow, Ctrl-R)"
                                                      if has_live else "") + ":")
    for name, (_, _, nums) in zip(names, found):
        word = "line" if len(nums) == 1 else "lines"
        out.append(f"  {name.ljust(width)}  {word} {', '.join(map(str, nums))}")
    out.append("Delete those lines to clean it up there too"
               + ("; see the README for editing history safely." if has_live else "."))
    return out, None


def remember_save(question, cmd):
    """Append `COMMAND  # QUESTION` to the answers file. None, or an error."""
    question = " ".join(question.split())
    cmd = cmd.strip()
    if ANSWERS == os.devnull:
        return "answers are off (HINTDB_ANSWERS=/dev/null)"
    if not cmd or "\n" in cmd:
        return "nothing to save: the command must be one line"
    if not question:
        return "nothing to save: no question"
    data = f"{cmd}  # {question}\n".encode()
    try:
        d = os.path.dirname(ANSWERS)
        if d:
            os.makedirs(d, exist_ok=True)
        fd = os.open(ANSWERS, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            os.write(fd, data)
        finally:
            os.close(fd)
    except OSError as e:
        return f"cannot write {ANSWERS}: {e}"
    return None

# ---------------------------------------------------------------- flags
# What each flag of a command does, from the tool's own documentation: a bash
# builtin's `help`, else its man page. No model, and never `TOOL --help` (it
# would run the program being checked). HINTDB_MAN / HINTDB_HELP replace the
# man and help commands (tests): each is run with the page name and prints
# the page, or exits non-zero when there is none.

MAN_CMD = os.environ.get("HINTDB_MAN")
HELP_CMD = os.environ.get("HINTDB_HELP")
FLAG_GAP = re.compile(r"\t| {2,}")          # between an option line's flags and its text
OVERSTRIKE = re.compile(r".\x08|\x1b\[[0-9;]*m")
_pages = {}


def doc_page(name, builtin=True):
    """(label, lines) of `help NAME` for a bash builtin, else `man NAME`;
    (None, None) when there is neither."""
    key = (name, builtin)
    if key in _pages:
        return _pages[key]
    res = (None, None)
    if builtin:
        cmd = (shlex.split(HELP_CMD) + [name] if HELP_CMD else
               ["bash", "-c", '[ "$(type -t -- "$1")" = builtin ] && help -- "$1"', "_", name])
        out = subprocess.run(cmd, capture_output=True, text=True)
        if out.returncode == 0 and out.stdout.strip():
            res = (f"help {name}", out.stdout.splitlines())
    if res[0] is None:
        # --nh --nj: no hyphenation or justification, so words are not split
        cmd = shlex.split(MAN_CMD) + [name] if MAN_CMD else ["man", "--nh", "--nj", name]
        env = dict(os.environ, LC_ALL="C", MANWIDTH="80", MANPAGER="cat", PAGER="cat")
        env.pop("MAN_KEEP_FORMATTING", None)
        out = subprocess.run(cmd, capture_output=True, text=True, env=env, errors="replace")
        if out.returncode == 0 and out.stdout.strip():
            lines = OVERSTRIKE.sub("", out.stdout).splitlines()
            sec = re.match(r"\S+\((\w+)\)", lines[0].strip()) if lines else None
            res = (f"{name}({sec.group(1)})" if sec else name, lines)
    _pages[key] = res
    return res


def option_head(line):
    """(flags, spec, description start, takes_value) when LINE starts an
    option entry, else None. The spec is the part before the gap:
    comma-separated items that all start with `-`, such as `-u user,
    --user=user`, or one bracketed list of them, as unzip writes its
    options (`[-d exdir]`)."""
    s = line.strip()
    m = re.match(r"\[([-+][^][]*)\](?=$|\t| {2})", s)
    if m:
        s = m.group(1) + s[m.end():]
    if s[:1] not in ("-", "+") or s[:2] in ("- ", "+ ") or s in ("-", "--", "+"):
        return None
    parts = FLAG_GAP.split(s, 1)
    spec, text = parts[0], parts[1].strip() if len(parts) > 1 else ""
    items = [i for i in re.split(r",\s+|,$", spec) if i]   # not ffmpeg's `(output,per-stream)`
    if not items or not all(re.match(r"-[^\s-]|--[^\s-]|\+[^\s+\d]", i) for i in items):
        return None
    flags, value = [], None
    for i in items:
        m = re.match(r"([-+][^\s=\[]*)(.*)", i)
        flags.append(m.group(1))
        rest = m.group(2)
        if rest.startswith("[=") or rest.strip().startswith("["):
            value = value or "optional"           # `-i [i]`, `--color[=WHEN]`
        elif rest.startswith("=") or (rest.startswith(" ") and rest.strip()[:1] not in ("", "-", "(")):
            value = "required"                    # not ffmpeg's `-vn (input/output)`
    return flags, spec, text, value


def indent(line):
    return len(line.expandtabs()) - len(line.expandtabs().lstrip())


def find_flag(lines, flag):
    """The option entry for FLAG: (spec, description, takes_value) or None.
    Of the lines naming it, the least indented wins (option lists are less
    indented than the text that mentions them). Option lines stacked with no
    text between them (`-c command` over `--command=command`) are one entry.
    The description runs to a blank line, the next option line, or a line
    indented less than the option."""
    best = None
    for i, line in enumerate(lines):
        head = option_head(line)
        if head and flag in head[0] and (best is None or indent(line) < best[0]):
            best = (indent(line), i)
    return entry_at(lines, best[1]) if best else None


def entry_at(lines, i):
    """The option entry whose option line is lines[i]: (spec, description,
    takes_value)."""
    ind = indent(lines[i])
    first = last = i
    while (first > 0 and option_head(lines[first - 1]) and indent(lines[first - 1]) == ind
           and not option_head(lines[first - 1])[2]):
        first -= 1
    while (not option_head(lines[last])[2] and last + 1 < len(lines)
           and option_head(lines[last + 1]) and indent(lines[last + 1]) == ind):
        last += 1
    heads = [option_head(lines[k]) for k in range(first, last + 1)]
    spec = ", ".join(h[1] for h in heads)
    value = next((h[3] for h in heads if h[3] == "required"), None) or \
        next((h[3] for h in heads if h[3]), None)
    desc = [heads[-1][2]] if heads[-1][2] else []
    for line in lines[last + 1:]:
        if not line.strip():
            if desc:
                break
            continue
        if option_head(line) or indent(line) < ind or (not desc and indent(line) == ind):
            break
        desc.append(line.strip())
    text = ""                                     # a line ending in a hyphen is a
    for d in desc:                                # real hyphen (no hyphenation)
        text += d if text.endswith("-") and text[-2:-1].isalpha() else (" " if text else "") + d
    return spec, " ".join(text.split()), value


def explain_command(words):
    """Explain the flags of one simple command (wrappers first). Returns a list
    of groups: (tool, label, [(spec, description) or (flag, None)]) and the
    index where the next wrapped command starts, or None."""
    i = 0
    while i < len(words) and ASSIGN.match(words[i]):
        i += 1
    if i >= len(words):
        return None, None
    tool = os.path.basename(words[i])
    pages, shown = [], tool
    if i + 1 < len(words) and not words[i + 1].startswith("-"):
        sub = doc_page(f"{tool}-{words[i + 1]}", builtin=False)
        if sub[0]:
            pages.append(sub)
            shown = f"{tool} {words[i + 1]}"
    main = doc_page(tool)
    if main[0]:
        pages.append(main)
    if not pages:
        return (shown, None, []), None
    label = " or ".join(p[0] for p in pages)

    def look(flag):
        for _, lines in pages:
            e = find_flag(lines, flag)
            if e:
                return e
        return None

    def is_value(k):
        """Words[k] is taken as a flag's value: not another flag (docker's
        `-d, --detach=true|false` takes none), except a negative number."""
        return k < len(words) and (not words[k].startswith("-") or
                                   re.fullmatch(r"-\d+", words[k]) is not None)

    out, j, wrapped = [], i + 1, None
    while j < len(words):
        w = words[j]
        j += 1
        if w == "--":
            break
        if w.startswith("+") and len(w) > 1:      # `dig +short`, `lsof +D`: only if listed
            e = look(w.split("=", 1)[0])
            if e:
                out.append((e[0], e[1]))
                if e[2] == "required" and "=" not in w and is_value(j):
                    j += 1
            continue
        if not w.startswith("-") or w == "-":
            if tool in PREFIX:
                wrapped = j - 1
                break
            continue
        name = w.split("=", 1)[0] if w.startswith("--") else w.split(":", 1)[0]  # ffmpeg -q:a
        e = look(name)
        if e:
            out.append((e[0], e[1]))
            if e[2] == "required" and "=" not in w and is_value(j):
                j += 1
            continue
        if w.startswith("--") or len(name) <= 2 or not name[1:].isalnum():
            out.append((name, None))
            continue
        for k, c in enumerate(name[1:], 1):       # a group, read as getopt does
            e = look("-" + c)
            if not e:
                out.append(("-" + c, None))
                continue
            out.append((e[0], e[1]))
            if e[2]:
                if e[2] == "required" and k == len(name) - 1 and is_value(j):
                    j += 1
                break                                 # the rest of the group is its value
    if tool in PREFIX and not out:
        return None, wrapped
    return (shown, label, out), wrapped


def flags_report(args):
    """(lines explaining every flag of the command(s) in ARGS, whether
    anything was not found). One argument is read as a command line (quoted
    pipelines); several are its words."""
    if len(args) == 1:
        lex = shlex.shlex(args[0], posix=True, punctuation_chars=True)
        lex.whitespace_split = True
        try:
            words = list(lex)
        except ValueError:
            words = args[0].split()
    else:
        words = list(args)
    segs, cur = [], []
    for w in words:
        if w in CMD_SEP or w == "&":
            segs.append(cur)
            cur = []
        elif not re.fullmatch(r"[<>&|()]+", w):
            cur.append(w)
    segs.append(cur)
    groups = []
    for seg in segs:
        while seg:
            g, nxt = explain_command(seg)
            if g:
                groups.append(g)
            if nxt is None:
                break
            seg = seg[nxt:]
    rows, missing = [], False
    for tool, label, entries in groups:
        missing = missing or label is None or any(d is None for _, d in entries)
        if label is None:
            rows.append((tool, "no man page or builtin help here"))
        elif not entries:
            rows.append((tool, "no flags"))
        for spec, desc in entries:
            rows.append((f"{tool} {spec}", desc if desc is not None else f"not in {label}"))
        rows.append(None)
    width = min(max((len(r[0]) for r in rows if r), default=0) + 2, 32)
    out = []
    for r in rows[:-1]:
        if r is None:
            out.append("")
            continue
        left, desc = r
        wrap = textwrap.wrap(desc, max(80 - width, 30), break_on_hyphens=False) or [""]
        if len(wrap) > 4:
            wrap = wrap[:4]
            wrap[3] += " ..."
        if len(left) + 2 > width:
            out.append(left)
            out += [" " * width + t for t in wrap]
        else:
            out.append(left.ljust(width) + wrap[0])
            out += [" " * width + t for t in wrap[1:]]
    return out, missing


# ---------------------------------------------------------------- man examples
# `hint man TOOL WORDS`: search one tool's documentation for a task and show
# the forms it gives: its tldr examples, its man page's example section and
# its option entries, ranked by bm25 in an in-memory FTS5 table. tldr pages
# are read from a local cache only: HINTDB_TLDR when set (also for tests),
# else tealdeer's; never fetched.

TLDR_DIRS = ([os.environ["HINTDB_TLDR"]] if "HINTDB_TLDR" in os.environ
             else [os.path.expanduser("~/.cache/tealdeer/tldr-pages")])
EXAMPLE_HEAD = re.compile(r"(USAGE )?EXAMPLES?$")


def tldr_root():
    for d in TLDR_DIRS:
        for sub in ("pages.en", "pages"):
            if os.path.isdir(os.path.join(d, sub)):
                return os.path.join(d, sub)
    return None


def tldr_command(cmd):
    """A tldr command as a form that is not runnable as printed:
    {{[-l|--listen]}} -> -l, {{a|b}} -> <a|b>, {{host}} -> host."""
    cmd = re.sub(r"\{\{\[([^]|]*)\|[^]]*\]\}\}", r"\1", cmd)
    cmd = re.sub(r"\{\{([^}]*\|[^}]*)\}\}", r"<\1>", cmd)
    return re.sub(r"\{\{(.*?)\}\}", r"\1", cmd)


def tldr_examples(name):
    """[(command, description)] of NAME's tldr page (common, then linux)."""
    root = tldr_root()
    if not root:
        return []
    for d in ("common", "linux"):
        path = os.path.join(root, d, name + ".md")
        if os.path.isfile(path):
            out, desc = [], None
            for line in open(path, errors="replace"):
                line = line.strip()
                if line.startswith("- "):
                    desc = re.sub(r"\[(\w+)\]", r"\1", line[2:].rstrip(":"))  # [c]reate
                elif line.startswith("`") and line.endswith("`") and desc:
                    out.append((tldr_command(line[1:-1]), desc))
                    desc = None
            return out
    return []


def man_examples(tool, lines):
    """[(command, description)] from a man page's EXAMPLES section. Two
    layouts: a description with the command indented below it (`$ nc -u
    host 53`), or the command with its description indented below (ss).
    Lines starting with `$ ` or the tool's name are commands."""
    start = next((i for i, l in enumerate(lines) if EXAMPLE_HEAD.match(l.strip())
                  and indent(l) < 4), None)
    if start is None:
        return []

    def is_cmd(text):
        return text.startswith("$ ") or text.split()[0] in (tool, "sudo")

    blocks, blank = [], True                      # [indent, after_blank, is_cmd, [text]]
    for line in lines[start + 1:]:
        if line.strip() and indent(line) == 0:    # the next section
            break
        if not line.strip():
            blank = True
            continue
        t, ind = line.strip(), indent(line)
        if blocks and blocks[-1][2] and blocks[-1][3][-1].endswith("\\"):
            blocks[-1][3][-1] = blocks[-1][3][-1][:-1].rstrip() + " " + t   # `\` continues
        elif blocks and not blank and blocks[-1][0] == ind and blocks[-1][2] == is_cmd(t):
            blocks[-1][3].append(t)
        else:
            blocks.append([ind, blank, is_cmd(t), [t]])
        blank = False
    out = []
    for k, (ind, after_blank, cmd, texts) in enumerate(blocks):
        if not cmd:
            continue
        above, m = [], k - 1                      # the paragraph above, less indented
        while m >= 0 and not blocks[m][2]:
            above[:0] = blocks[m][3]
            if blocks[m][1]:
                break
            m -= 1
        below, m = [], k + 1                      # or the lines right below, deeper
        while (m < len(blocks) and not blocks[m][2] and not blocks[m][1]
               and blocks[m][0] > ind):
            below += blocks[m][3]
            m += 1
        if below:
            desc = below
        elif above and blocks[k - 1][0] < ind:
            desc = above
        else:
            continue
        desc = re.sub(r"(^|\s)\*\s+", r"\1", " ".join(" ".join(desc).split())).rstrip(":")
        cmds = [t[2:] if t.startswith("$ ") else t for t in texts]
        own = [c for c in cmds if c.split()[0] in (tool, "sudo")]
        out += [(c, desc) for c in own or cmds]
    return out


TLDR_NOTE = ("# no tldr pages here: install tealdeer (or another tldr client) and run "
             "tldr --update for more forms (https://github.com/tldr-pages/tldr)")


def man_search(tool, words):
    """Lines answering `hint man TOOL WORDS`, and whether anything matched.
    A subcommand page (git-commit for `git commit ...`) is read first."""
    rest = list(words)
    names = [tool]
    sub = f"{tool}-{rest[0]}" if rest else None
    if sub and (doc_page(sub, builtin=False)[0] or tldr_examples(sub)):
        names.insert(0, sub)
        rest = rest[1:]
    terms = [t for t in query_terms(" ".join(rest)) if t != tool]   # on every passage
    passages = []                                 # (rank, form, note)
    for name in names:
        for cmd, desc in tldr_examples(name):
            passages.append((0, cmd, "tldr: " + desc, desc + " " + cmd))
        label, lines = doc_page(name, builtin=(name == tool))
        if not lines:
            continue
        label = label if label.startswith("help ") else "man " + label
        for cmd, desc in man_examples(tool, lines):
            passages.append((0, cmd, f"{label} example: {desc}", desc + " " + cmd))
        for i, line in enumerate(lines):
            head = option_head(line)
            prev = option_head(lines[i - 1]) if i else None
            stacked = prev and not prev[2] and indent(lines[i - 1]) == indent(line)
            if head and indent(line) < 16 and not stacked:   # a stack is one entry
                e = entry_at(lines, i)
                if e and e[1]:
                    flag = min(head[0], key=len)
                    passages.append((1, f"{tool} {flag}", f"{label} {flag}: {e[1]}",
                                     e[0] + " " + e[1]))
    if not terms or not passages:
        return ([TLDR_NOTE] if not tldr_root() else []), False
    con = sqlite3.connect(":memory:")
    con.execute("CREATE VIRTUAL TABLE p USING fts5(body, tokenize = 'porter unicode61')")
    con.executemany("INSERT INTO p(rowid, body) VALUES (?, ?)",
                    [(k, p[3]) for k, p in enumerate(passages)])
    q = " OR ".join('"%s"' % t.replace('"', "") for t in terms)
    hits = con.execute("SELECT rowid, bm25(p) FROM p WHERE p MATCH ?", (q,)).fetchall()
    hits.sort(key=lambda h: (passages[h[0]][0], h[1]))   # examples before option entries
    out, seen, shown, example = [], set(), [0, 0], False
    for rowid, _ in hits:                         # up to 3 examples, then 2 option entries
        kind, form, note, _ = passages[rowid]
        if form in seen or shown[kind] == (3, 2)[kind]:
            continue
        seen.add(form)
        shown[kind] += 1
        example = example or kind == 0
        if len(note) > 110:
            note = note[:106].rsplit(" ", 1)[0] + " ..."
        out += [form, "  # " + note]
        if len(seen) == 5:
            break
    if not example and not tldr_root():           # thin: only option entries, or nothing
        out.append(TLDR_NOTE)
    return out, bool(seen)


# ---------------------------------------------------------------- cli


def report(res):
    n, m = res
    parts = [f"{n} entries" if n is not None else "entries up to date"]
    if man_enabled():
        parts.append(f"{m} man pages" if m is not None else "man pages up to date")
    print("hintdb: " + ", ".join(parts))


def main():
    ap = argparse.ArgumentParser(prog="hintdb", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="op", required=True)
    a = sub.add_parser("add")
    a.add_argument("paths", nargs="+")
    a.add_argument("--kind", choices=KINDS)
    r = sub.add_parser("remove")
    r.add_argument("paths", nargs="+")
    sub.add_parser("sources")
    sub.add_parser("rebuild")
    sub.add_parser("update")
    a = sub.add_parser("stats")
    a.add_argument("--source", metavar="PATH")
    fd = sub.add_parser("find")
    fd.add_argument("-q", "--query", required=True, help="the question, in the user's words")
    fd.add_argument("--no-update", action="store_true")
    fd.add_argument("--debug", action="store_true", help="scores to stderr")
    fd.add_argument("guesses", nargs="*", help="the model's guessed commands")
    lg = sub.add_parser("log")
    lg.add_argument("-n", "--last", type=int, default=10, help="last N matching lookups")
    lg.add_argument("--all", action="store_true", help="every matching lookup (for hint grep)")
    lg.add_argument("-c", "--count", action="store_true", help="print the number of matching lookups")
    lg.add_argument("-s", "--show", type=int, metavar="N", help="the full entry number N")
    lg.add_argument("-d", "--delete", metavar="N[,N|N-M]...",
                    help="delete entries (their numbers stay unused)")
    lg.add_argument("words", nargs="*")
    an = sub.add_parser("remember")
    an.add_argument("--save", action="store_true", help="append COMMAND  # QUESTION")
    an.add_argument("-q", "--query", help="the question (with --save)")
    an.add_argument("words", nargs="*", help="TOOL, or with --save the COMMAND")
    fg = sub.add_parser("forget")
    fg.add_argument("--where", action="store_true",
                    help="list the files and lines holding COMMAND")
    fg.add_argument("--marked", action="store_true",
                    help="exit 0 and say where, if COMMAND is already marked WRONG")
    fg.add_argument("--save", action="store_true",
                    help="append COMMAND  # WRONG! (or # WRONG: REASON) to the wrong file")
    fg.add_argument("--reason", help="with --save")
    fg.add_argument("words", nargs="*", help="TOOL, or with --where/--marked/--save the COMMAND")
    mn = sub.add_parser("man")
    mn.add_argument("words", nargs=argparse.REMAINDER, help="TOOL WORDS...")
    fl = sub.add_parser("flags")
    fl.add_argument("command", nargs=argparse.REMAINDER,
                    help="the command's words, or the whole command as one word")
    q = sub.add_parser("query")
    q.add_argument("-n", type=int, default=15)
    q.add_argument("--no-update", action="store_true")
    q.add_argument("words", nargs="*")
    args = ap.parse_args()

    if args.op in ("add", "remove"):
        srcs = load_sources()
        paths = [os.path.abspath(os.path.expanduser(p)) for p in args.paths]
        if args.op == "add":
            for p in paths:
                if not os.path.exists(p):
                    sys.exit(f"hintdb: no such file or directory: {p}")
                if not any(sp == p for _, sp in srcs):
                    srcs.append((args.kind or "auto", p))
        else:
            srcs = [(k, sp) for k, sp in srcs if sp not in paths]
        save_sources(srcs)
        files = all_files(srcs)
        print(f"hintdb: {build(files)} entries")
    elif args.op == "sources":
        for kind, path in load_sources():
            print(f"{kind}\t{path}")
        if ANSWERS != os.devnull:
            state = "" if os.path.isfile(ANSWERS) else ", no answers yet"
            print(f"history\t{ANSWERS}\t(built in: hint remember{state})")
        if WRONG != os.devnull:
            state = "" if os.path.isfile(WRONG) else ", nothing marked yet"
            print(f"history\t{WRONG}\t(built in: hint forget{state})")
    elif args.op == "remember" and args.save:
        err = remember_save(args.query or "", " ".join(args.words))
        if err:
            sys.exit("hintdb: " + err)
        print(f"hintdb: saved to {tilde(ANSWERS)}")
    elif args.op == "forget" and args.save:
        lines, err = forget_save(" ".join(args.words), args.reason or "")
        if err:
            sys.exit("hintdb: " + err)
        print("\n".join(lines))
    elif args.op == "forget" and args.marked:
        found, marked, _ = forget_where(" ".join(args.words))
        if not marked:
            sys.exit(1)
        print(marked_line(" ".join(args.words), marked))
    elif args.op == "forget" and args.where:
        lines = forget_report(" ".join(args.words))
        if lines is None:
            sys.exit(f"hintdb: {' '.join(args.words)} is in none of your sources "
                     "or your history file")
        print("\n".join(lines))
    elif args.op == "forget":
        if len(args.words) > 1:
            sys.exit("hintdb: forget takes at most one TOOL")
        if WRONG == os.devnull:
            sys.exit("hintdb: marks are off (HINTDB_WRONG=/dev/null)")
        lines, err = forget_pick(args.words[0] if args.words else "")
        if err:
            sys.exit("hintdb: " + err)
        print("\n".join(lines))
    elif args.op == "remember":
        if len(args.words) > 1:
            sys.exit("hintdb: remember takes at most one TOOL")
        res, err = remember_candidate(args.words[0] if args.words else "")
        if err:
            sys.exit("hintdb: " + err)
        print_pick(res)
    elif args.op == "man":
        words = args.words[1:] if args.words[:1] == ["--"] else args.words
        if len(words) < 2:
            sys.exit("hintdb: man needs a tool and words, e.g. hintdb man -- nc connect to port")
        lines, found = man_search(os.path.basename(words[0]), words[1:])
        if not found:
            lines.insert(0, f"nothing about \"{' '.join(words[1:])}\" in {words[0]}'s "
                            "tldr page, man page or help")
        print("\n".join(lines))
        sys.exit(0 if found else 1)
    elif args.op == "flags":
        words = args.command[1:] if args.command[:1] == ["--"] else args.command
        if not words:
            sys.exit("hintdb: flags needs a command, e.g. hintdb flags -- ss -tuln")
        lines, missing = flags_report(words)
        print("\n".join(lines))
        sys.exit(1 if missing else 0)             # like grep: 1 = something not found
    elif args.op == "rebuild":
        report(update(force=True))
    elif args.op == "update":
        report(update())
    elif args.op == "stats" and args.source:
        update()
        con = sqlite3.connect(DB)
        lines = source_entries(con, args.source)
        con.close()
        if not lines:
            sys.exit(f"hintdb: no entries from {args.source} "
                     "(see `hintdb stats` for the source files)")
        for line in lines:
            print(line)
    elif args.op == "stats":
        update()
        con = sqlite3.connect(DB)
        for kind, c, s in con.execute(
                "SELECT kind, COUNT(*), SUM(count) FROM entries GROUP BY kind"):
            print(f"{kind}\t{c} entries from {s} raw lines")
        per = source_counts(con)
        con.close()
        if os.path.exists(MANDB):
            con = sqlite3.connect(MANDB)
            print(f"man\t{con.execute('SELECT COUNT(*) FROM pages').fetchone()[0]} pages")
            con.close()
        for path, (n, own) in per:
            print(f"{tilde(path)}\t{n} {'entry' if n == 1 else 'entries'}, {own} only from this source")
        con = sqlite3.connect(DB)
        row = con.execute("SELECT value FROM meta WHERE key='wrong'").fetchone()
        con.close()
        marks = json.loads(row[0]) if row else []
        if marks:
            print("marked WRONG (never shown by hint):")
            width = max(len(c) for c, _, _, _ in marks)
            for c, p, n, note in marks:
                print(f"  {c.ljust(width)}  {tilde(p)} line {n}: {note}")
    elif args.op == "find":
        if not args.no_update:
            update()
        rows = []
        out = find(args.query, args.guesses, args.debug, rows)
        for line in out:
            print(line)
        sys.stdout.flush()
        log_lookup(args.query, args.guesses, out, rows)
    elif args.op == "log":
        if args.delete is not None:
            done, err = log_delete(args.delete)
            for r in done:
                print("deleted %5d  %s  %s" % (r["n"], log_time(r), r["query"]))
            if err:
                sys.exit("hintdb: " + err)
            sys.exit(0)
        if args.show is not None:
            lines = log_show(args.show)
            if lines is None:
                sys.exit(f"hintdb: no entry {args.show} in the query log")
            print("\n".join(lines))
            sys.exit(0)
        if args.last < 1:
            sys.exit("hintdb: --last needs a number of 1 or more")
        # A quoted phrase is several words, all of which must match.
        entries = log_history([w for a in args.words for w in a.split()])
        if args.count:
            print(len(entries))
        else:
            for entry in (entries if args.all else entries[-args.last:]):
                print("\n".join(entry))
        sys.exit(0 if entries else 1)
    elif args.op == "query":
        if not args.no_update:
            update()
        for line in query(" ".join(args.words), args.n):
            print(line)


if __name__ == "__main__":
    main()
